# Opens or closes a port in ufw.
ufw_port() {
  local port
  port=$(ask "Port with its protocol, like 443/tcp:")
  if ! [[ $port =~ ^[0-9]+(/(tcp|udp))?$ ]]; then
    bad "'$port' is not a port"
    return 1
  fi

  if [ "$1" = allow ]; then
    host_command "opening $port" "ufw allow $port" || return 1
  else
    host_command "closing $port" "ufw delete allow $port" || return 1
  fi

  if ! command -v ufw > /dev/null 2>&1; then
    bad "ufw is not installed: item 10 of this menu puts it on"
    return 1
  fi

  if [ "$1" = allow ]; then
    ufw allow "$port"
  else
    ufw delete allow "$port"
  fi
}

# Turns ufw on with ssh kept open and lets the panel lay its rules.
ufw_on() {
  host_command "turning ufw on" "apt-get install -y ufw; ufw allow <the port of ssh>/tcp; ufw --force enable" || return 1
  if ! command -v ufw > /dev/null 2>&1; then
    agree "ufw is not installed. Install it?" || return 0
    apt-get install -y ufw || return 1
  fi

  ufw allow "$(ssh_port)/tcp" > /dev/null
  ufw --force enable
  good "the firewall is on, TCP $(ssh_port) stays open for ssh"
  if [ "$(kind)" != none ]; then
    restart_panel
  fi
}

