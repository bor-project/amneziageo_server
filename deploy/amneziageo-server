# Item 7: sets the password of an administrator, or makes one under a new login.
reset_login() {
  local login users
  need_panel || return 1
  users=$(reading accounts)
  printf '%s\n' "$users"
  login=$(ask "Login:")
  if [ -z "$login" ]; then
    return 0
  fi

  if printf '%s\n' "$users" | awk 'NR > 1 {print $1}' | grep -qx "$login"; then
    cli_in user passwd "$login" --permanent && cli user enable "$login" > /dev/null
  elif host_user "$login"; then
    say "The host carries a user $login: an administrator of the panel under that name joins the groups amneziageo and"
    say "amneziageo-admin of the host and signs in to the panel with a password."
    agree "Make $login an administrator of the panel?" || return 0
    cli_in user add "$login" --role admin --host --permanent
  elif ! agree "There is no $login. Make an administrator $login?"; then
    return 0
  elif printf '%s\n' "$users" | grep -q '^no users yet'; then
    cli_in init --user "$login" --permanent
  else
    cli_in user add "$login" --role admin --permanent
  fi
}

