# Item 18: the service, the answer of the panel and what the host lacks, with the fixes it takes.
check_status() {
  local kind version
  kind=$(kind)
  step "the panel"
  case $kind in
    package) systemctl --no-pager status "$unit" 2> /dev/null | head -4 ;;
    docker) dcompose ps panel ;;
    container) say "container $(own_name), the panel $(panel_state)" ;;
    *) say "not installed" ;;
  esac

  if [ "$kind" != none ]; then
    version=$(running_version)
    if [ -n "$version" ]; then
      good "answers, version $version"
    else
      bad "does not answer"
    fi

    say "autostart $(autostart_state)"
  fi

  step "the host"
  if module_loaded; then
    good "amneziawg module loaded"
  else
    bad "amneziawg module not loaded"
    if modinfo amneziawg > /dev/null 2>&1 && agree "Load it now and at boot?"; then
      printf 'amneziawg\n' > /etc/modules-load.d/amneziawg.conf
      modprobe amneziawg && good "amneziawg module loaded"
    fi
  fi

  if forwarding; then
    good "forwarding on"
  else
    bad "forwarding off"
    if [ "$(kind)" = container ]; then
      host_command "turning forwarding on" \
        "printf 'net.ipv4.ip_forward = 1\nnet.ipv6.conf.all.forwarding = 1\n' > $forwarding_conf && sysctl -p $forwarding_conf"
    elif agree "Turn forwarding on?"; then
      forwarding_on
    fi
  fi

  if { [ "$kind" = docker ] || [ "$kind" = container ]; } && nft list chain ip filter FORWARD 2> /dev/null | grep -q 'policy drop'; then
    bad "docker drops forwarded packets: add \"ip-forward-no-drop\": true to /etc/docker/daemon.json and restart docker"
  fi

  say "websocket fronts $(fronts_running), BBR $(bbr_state)"
}

