# Items 20 and 21: lets the panel start with the host or not.
autostart() {
  need_panel || return 1
  if [ "$(kind)" = package ]; then
    if [ "$1" = on ]; then
      systemctl enable "$unit" 2> /dev/null
    else
      systemctl disable "$unit" 2> /dev/null
    fi
  elif [ "$(kind)" = container ]; then
    if [ "$1" = on ]; then
      engine POST "/containers/$(own_container)/update" '{"RestartPolicy":{"Name":"unless-stopped"}}' > /dev/null
    else
      engine POST "/containers/$(own_container)/update" '{"RestartPolicy":{"Name":"no"}}' > /dev/null
    fi
  elif [ "$1" = on ]; then
    docker update --restart unless-stopped "$(container_id)" > /dev/null
  else
    docker update --restart no "$(container_id)" > /dev/null
  fi

  good "autostart $(autostart_state)"
}

# Gives the container the certificates of the host through a compose override the script owns, and starts the
# container over on it unless told the panel stays stopped.
share_certificates() {
  local override=$docker_dir/compose.override.yaml
  if [ "$(kind)" != docker ] || grep -qs '/etc/letsencrypt:/etc/letsencrypt' "$override"; then
    return 0
  fi

  if [ -f "$override" ] && ! grep -qxF "$override_mark" "$override"; then
    bad "add to the volumes of the panel in $override: - /etc/letsencrypt:/etc/letsencrypt:ro"
    return 1
  fi

  printf '%s\nservices:\n  panel:\n    volumes:\n      - /etc/letsencrypt:/etc/letsencrypt:ro\n' "$override_mark" > "$override"
  if [ "${1:-}" != stopped ]; then
    dcompose up -d > /dev/null && wait_panel
  fi
}

# Puts a certificate of the host on the panel.
use_certificate() {
  local chain=$1 key=$2
  share_certificates || return 1
  cli panel set --certificate "$chain" --key "$key" || return 1
  if [ "$(setting listen)" = 127.0.0.1 ] && agree "Let the panel answer on every address of the host?"; then
    cli panel set --listen all > /dev/null
  fi

  restart_panel && show_address
}

# Gets a Let's Encrypt certificate for a name of the host and puts it on the panel.
get_certificate() {
  local name live
  host_only "getting a certificate of Let's Encrypt" || return 1
  name=$(ask "Name of the host, like panel.example.org:")
  if [ -z "$name" ]; then
    return 0
  fi

  certify "$name" || return 1
  live=/etc/letsencrypt/live/$name
  use_certificate "$live/fullchain.pem" "$live/privkey.pem"
}

# Gets a Let's Encrypt certificate with an RSA key for a name of the host, no questions of certbot given an email or none.
certify() {
  local name=$1 who=() kind=()
  if ! getent ahostsv4 "$name" > /dev/null; then
    bad "$name does not resolve"
    return 1
  fi

  if [ -n "$(ss -ltnH 'sport = :80' 2> /dev/null)" ]; then
    bad "TCP port 80 is taken on this host, certbot answers the check of Let's Encrypt on it"
    return 1
  fi

  if ! command -v certbot > /dev/null 2>&1; then
    apt-get install -y certbot || return 1
  fi

  if ufw_active && ! ufw_lets 80/tcp; then
    ufw allow 80/tcp > /dev/null
  fi

  if [ $# -gt 1 ] && [ -n "$2" ]; then
    who=(--non-interactive --agree-tos --no-eff-email -m "$2")
  elif [ $# -gt 1 ]; then
    who=(--non-interactive --agree-tos --register-unsafely-without-email)
  fi

  if certbot --help all 2> /dev/null | grep -q -- '--key-type'; then
    kind=(--key-type rsa --rsa-key-size 2048)
    if grep -qs '^key_type = ecdsa' "/etc/letsencrypt/renewal/$name.conf"; then
      kind+=(--force-renewal)
    fi
  fi

  certbot certonly --standalone --preferred-challenges http "${who[@]}" "${kind[@]}" --cert-name "$name" -d "$name" || return 1
  systemctl enable --now certbot.timer > /dev/null 2>&1
}

# Lists the certificates of the host and the one the panel answers under.
show_certificates() {
  local chain
  if command -v certbot > /dev/null 2>&1; then
    certbot certificates 2> /dev/null
  elif [ -d /etc/letsencrypt/live ]; then
    say "certificates of the host: $(ls /etc/letsencrypt/live | grep -v README | tr '\n' ' ')"
  fi

  chain=$(setting certificate)
  if [ -z "$chain" ]; then
    say "the panel holds no certificate"
  else
    say "the panel answers under $chain"
    openssl x509 -noout -subject -enddate -in "$chain" 2> /dev/null
  fi
}

