    say "  2. Restart the fronts"
    say "  3. The logs of the fronts"
    say "  0. Back"
    choice=$(ask "Choose:") || return 0
    case $choice in
      1)
        reading cli endpoint list
        if [ "$(kind)" = package ]; then
          systemctl list-units --all --no-pager 'amneziageo-proxy@*'
        fi
        ;;
      2)
        if [ "$(kind)" = package ]; then
          for unit_name in $(front_units); do
            systemctl restart "$unit_name" && say "restarted $unit_name"
          done
        else
          restart_panel
        fi
        ;;
      3) fronts_log ;;
      0 | "") return 0 ;;
      *) bad "there is no item $choice" ;;
    esac
  done
}

# Item 27: turns BBR with the fq queue on or off for good.
# Prints the commands that turn BBR on or off on a host the script does not reach.
bbr_command() {
  local cmd
  if [ "$1" = on ]; then
    cmd="modprobe tcp_bbr"$'\n'"printf 'tcp_bbr\n' > $bbr_module"$'\n'
    if [ -e "$qdisc_file" ]; then
      cmd+="printf 'net.core.default_qdisc = fq\nnet.ipv4.tcp_congestion_control = bbr\n' > $bbr_conf"
    else
      cmd+="printf 'net.ipv4.tcp_congestion_control = bbr\n' > $bbr_conf"
    fi

    printf '%s\nsysctl -p %s' "$cmd" "$bbr_conf"
  else
    cmd="rm -f $bbr_conf $bbr_module"$'\n'"sysctl -w net.ipv4.tcp_congestion_control=cubic"
    if [ -e "$qdisc_file" ]; then
      cmd+=$'\n'"sysctl -w net.core.default_qdisc=fq_codel"
    fi

    printf '%s' "$cmd"
  fi
}

bbr_item() {
  local want=${1:-}
  say "congestion control  $(sysctl -n net.ipv4.tcp_congestion_control 2> /dev/null)"
  if [ -e "$qdisc_file" ]; then
    say "queue discipline    $(cat "$qdisc_file")"
  fi
  if [ -z "$want" ]; then
    if bbr_on; then
      if confirm "Turn BBR off?"; then
        want=off
      fi
    elif agree "Turn BBR on?"; then
      want=on
    fi
  fi

  case $want in
    on) host_command "turning BBR on" "$(bbr_command on)" && bbr_enable ;;
    off) host_command "turning BBR off" "$(bbr_command off)" && bbr_disable ;;
    "") ;;
    *) bad "bbr takes on or off" ;;
  esac
}

# Prints whether the resolver of the panel answers the clients and whether it asks outside encrypted.
resolver_line() {
  local values
  mapfile -t values < <(cli dns get enabled encrypted 2> /dev/null | tr -d '\r')
  case ${values[0]:-} in
    on)
      case ${values[1]:-} in
        all) printf 'on, asks outside encrypted' ;;
        none) printf 'on, asks outside in the open' ;;
        *) printf 'on, asks outside partly in the open' ;;
      esac
      ;;
    off) printf 'off' ;;
  esac
}

# Item 29: turns the resolver of the clients on or off; turned off it does not run and holds no port.
resolver_item() {
  local want=${1:-} state usual=
  need_panel || return 1
  reading cli dns show || return 1
  state=$(reading resolver_line)
  if [ -z "$want" ]; then
    case $state in
      on*)
        if [ "$state" != 'on, asks outside encrypted' ] && agree "Ask the name servers the panel starts with, over HTTPS?"; then
          want=on
          usual=1
        elif confirm "Turn the resolver off?"; then
          want=off
        fi
        ;;
      *)
        if agree "Turn the resolver on?"; then
          want=on
          if [ "$(cli dns get encrypted 2> /dev/null | tr -d '\r')" != all ] \
            && agree "Its name servers are asked in the open: ask the ones the panel starts with, over HTTPS?"; then
            usual=1
          fi
        fi
        ;;
    esac
  fi

  case $want in
    on | off) cli dns set --enabled "$want" ${usual:+--upstreams default} || return 1 ;;
    "") ;;
    *)
      bad "dns takes on, off or open"
      return 1
      ;;
  esac

  if [ "$want" != off ] && [ "$(cli dns get enabled 2> /dev/null | tr -d '\r')" = on ]; then
    resolver_offer
  fi
}

# Prints the names of the endpoints of the panel, one a line.
endpoint_names() {
  cli endpoint list 2> /dev/null | tr -d '\r' | sed -n 's/^\([A-Za-z0-9_.-]*\): .*/\1/p'
}

# Prints the interfaces of the endpoints whose clients ufw keeps from the resolver of the panel, one a line.
resolver_kept() {
  local port name
  if [ "$(kind)" = container ] || ! ufw_active || [ "$(cli dns get enabled 2> /dev/null | tr -d '\r')" != on ]; then
    return 0
  fi

  port=$(cli dns get port 2> /dev/null | tr -d '\r')
  while read -r name; do
    if ! ufw_lets_in "$name" "${port:-53}"; then
      printf '%s\n' "$name"
    fi
  done < <(endpoint_names)
}

# Item 23, 13: lets the clients of the endpoints reach the resolver of the panel through ufw.
resolver_open() {
  local port name kept=()
  need_panel || return 1
  port=$(cli dns get port 2> /dev/null | tr -d '\r')
  port=${port:-53}
  if [ "$(kind)" = container ]; then
    host_command "letting the clients reach the resolver" \
      "$(endpoint_names | sed "s/.*/ufw allow in on & to any port $port/" | paste -sd ';' - | sed 's/;/; /g')"
    return 1
  fi

  if [ "$(cli dns get enabled 2> /dev/null | tr -d '\r')" != on ]; then
    bad "the resolver is off: item 29 of the menu turns it on"
    return 1
  fi

  if ! ufw_active; then
    good "ufw is off and keeps no client from the resolver"
    return 0
  fi

  mapfile -t kept < <(resolver_kept)
  if [ ${#kept[@]} -eq 0 ]; then
    good "ufw lets the clients of every endpoint reach the resolver on port $port"
    return 0
  fi

  for name in "${kept[@]}"; do
    if ufw allow in on "$name" to any port "$port" comment "amneziageo resolver $name" > /dev/null; then
      good "ufw lets the clients of $name reach the resolver on port $port"
    else
      bad "ufw did not let the clients of $name reach the resolver on port $port"
    fi
  done
}

# Offers to let the clients that ufw keeps from the resolver of the panel reach it.
resolver_offer() {
  local kept=()
  mapfile -t kept < <(resolver_kept)
  if [ ${#kept[@]} -gt 0 ] && agree "ufw keeps the clients of ${kept[*]} from the resolver: let them reach it?"; then
    resolver_open
  fi
}

# Offers at the end of the installation to let the clients that ufw keeps from the resolver of the panel reach it.
install_doors() {
  local kept=()
  mapfile -t kept < <(resolver_kept)
  if [ ${#kept[@]} -eq 0 ]; then
    return 0
  fi

  answer_yes resolver_ufw "ufw keeps the clients of ${kept[*]} from the resolver of the panel: let them reach it?" yes || true
  if [ "${given[resolver_ufw]}" = yes ]; then
    resolver_open
  fi
}

# Writes a line of the menu frame.
row() {
  printf '│  %-45s│\n' "$1"
}

# Writes a numbered item of the menu.
entry() {
  printf '│  %2s. %-41s│\n' "$1" "$2"
}

# Writes a divider of the menu.
rule() {
  printf '%s\n' '│───────────────────────────────────────────────│'
}

# Writes the state of the panel and the host under the menu.
status_block() {
  local kind state line version channel services
  kind=$(kind)
  state=$(panel_state)
  line=$state
  if [ "$kind" != none ]; then
    version=$(running_version)
    channel=$(setting channel)
    line="$state, ${kind/container/docker}${version:+ $version}${channel:+, $channel channel}"
  fi

  case $state in
    running) line="$green$line$plain" ;;
    *) line="$red$line$plain" ;;
  esac

  printf 'Panel:      %s\n' "$line"
  printf 'Autostart:  %s\n' "$(autostart_state)"
  printf 'Kernel:     amneziawg %s, forwarding %s\n' \
    "$(module_loaded && printf loaded || printf 'not loaded')" "$(forwarding && printf on || printf off)"
  printf 'Websocket:  %s front(s), BBR %s\n' "$(fronts_running)" "$(bbr_state)"
  if [ "$kind" != none ]; then
    printf 'DNS:        %s\n' "$(resolver_line)"
  fi

  [ "$state" = running ] || return 0
  services=$(services_line)
  case $services in
    '') ;;
    *down*) printf 'Services:   %s%s%s\n' "$red" "$services" "$plain" ;;
    *) printf 'Services:   %s%s%s\n' "$green" "$services" "$plain" ;;
  esac
}

