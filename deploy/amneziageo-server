  if [ "${subscriptions[0]:-}" = on ]; then
    say "TCP ${subscriptions[1]:-}  the subscriptions, held open: ${subscriptions[2]:-}"
  fi

  cli endpoint list
  if [ -d /etc/letsencrypt/live ]; then
    say "TCP 80  renewals of Let's Encrypt"
  fi
