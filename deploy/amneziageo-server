    status_block
    choice=$(ask "Choose [0-28]:") || exit 0
    hold=1
    case $choice in
      0) exit 0 ;;
      1) install_panel ;;
      2) update_panel ;;
      3) update_panel beta ;;
      4) rollback_panel ;;
      5) releases_menu && hold= ;;
      6) uninstall_panel ;;
      7) reset_login ;;
      8) users_menu && hold= ;;
      9) tokens_menu && hold= ;;
      10) reset_path ;;
      11) reset_settings ;;
      12) change_port ;;
      13) listen_menu && hold= ;;
      14) view_settings ;;
      15) need_panel && start_panel ;;
      16) need_panel && stop_panel && good "the panel is stopped" ;;
      17) need_panel && restart_panel ;;
      18) check_status ;;
      19) logs_menu && hold= ;;
      20) autostart on ;;
      21) autostart off ;;
      22) ssl_menu && hold= ;;
      23) firewall_menu && hold= ;;
      24) ssh_menu ;;
      25) endpoints_menu && hold= ;;
      26) fronts_menu && hold= ;;
      27) bbr_item ;;
      28) need_panel && cli geo update ;;
      "") hold= ;;
      *) bad "there is no item $choice" ;;
    esac

    if [ -n "$hold" ]; then
      pause
    fi
  done
}

# Writes how the script is called.
usage() {
  cat <<'EOF'
usage:
  amneziageo-server                    open the menu
  amneziageo-server install            put the panel on this host
  amneziageo-server install --restore <file>
                                       put the panel on this host on a backup downloaded from a panel
  amneziageo-server restore <file>     put a backup downloaded from a panel in place of the database
  amneziageo-server update [beta]      move the panel to the newest release, of the test channel for beta
  amneziageo-server rollback           go back to the release before
  amneziageo-server uninstall          take the panel off this host
  amneziageo-server settings           what the panel answers under
  amneziageo-server start | stop | restart | status
  amneziageo-server log                follow the log of the panel
  amneziageo-server enable | disable   start the panel with the host or not
  amneziageo-server bbr [on | off]     BBR with the fq queue for TCP
  amneziageo-server <command>          a command of the utility: user, role, token, panel, endpoint,
                                       import, device, family, geo, init, login, whoami, update status
EOF
}

# Runs the menu, an item or a command of the utility.
main() {
  case ${1:-} in
    help | -h | --help)
      usage
      return 0
      ;;
  esac

  need_root
  locate_compose
  case ${1:-} in
    "") menu ;;
    install)
      if [ "${2:-}" = --restore ] && [ -n "${3:-}" ]; then
        install_panel "$3"
      elif [ -n "${2:-}" ]; then
        usage
        return 1
      else
        install_panel
      fi
      ;;
    restore) restore_file "${2:-}" ;;
    update)
      case ${2:-} in
        "") update_panel ;;
        beta) update_panel beta ;;
        *) cli_in "$@" ;;
      esac
      ;;
    rollback) rollback_panel ;;
    uninstall) uninstall_panel ;;
    settings) view_settings ;;
    start) need_panel && start_panel ;;
    stop) need_panel && stop_panel ;;
    restart) need_panel && restart_panel ;;
    status) check_status ;;
    log) need_panel && follow_log ;;
    enable) autostart on ;;
    disable) autostart off ;;
    bbr) bbr_item "${2:-}" ;;
    *) cli_in "$@" ;;
  esac
}

main "$@"
