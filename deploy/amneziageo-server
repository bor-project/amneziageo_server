#!/usr/bin/env bash
# Manages the AmneziaGeo server on this host: the menu without arguments, its items and the utility as commands.
# AMNEZIAGEO_KIND, AMNEZIAGEO_CLI, AMNEZIAGEO_DATA, AMNEZIAGEO_UNIT and AMNEZIAGEO_DOCKER_DIR move it onto another layout.
set -uo pipefail

repo=bor-project/amneziageo_server
image=ghcr.io/bor-project/amneziageo-server
self=/usr/local/bin/amneziageo-server
base=/opt/amneziageo-server
etc=/etc/amneziageo-server
data=${AMNEZIAGEO_DATA:-/var/lib/amneziageo-server}
unit=${AMNEZIAGEO_UNIT:-amneziageo-server}
docker_dir=${AMNEZIAGEO_DOCKER_DIR:-/opt/amneziageo-docker}
endpoints=/etc/amnezia/amneziawg
run_dir=/run/amneziageo-server
docker_socket=/var/run/docker.sock
forwarding_conf=/etc/sysctl.d/90-amneziageo.conf
bbr_conf=/etc/sysctl.d/91-amneziageo-bbr.conf
bbr_module=/etc/modules-load.d/amneziageo-bbr.conf
qdisc_file=/proc/sys/net/core/default_qdisc
os_release=/etc/os-release
override_mark='# written by amneziageo-server'
answers_file=/root/.amneziageo-install
declare -gA given=() seen=()
made_password=
made_client=
made_link=
made_shortcut=
server_name=
api_base=
api_work=
spinning=
kept_tty=
ppa_key=75C9DD72C799870E310542E24166F2C257290828
release_key='-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEzgZ6s+M0wvE0HMsFuPhwk7cZsCSY
vbaWhP248NSthVEmlp9mRRjOf9zIFsIZ5P4mM1ETGo+l/Gb+S+7TcwVUew==
-----END PUBLIC KEY-----'

if [ -t 1 ]; then
  red=$'\e[31m'
  green=$'\e[32m'
  yellow=$'\e[33m'
  plain=$'\e[0m'
else
  red=
  green=
  yellow=
  plain=
fi

person=
if [ -t 0 ] && [ -t 1 ] && [ -t 2 ]; then
  person=1
fi

# Writes a line.
say() {
  printf '%s\n' "$*"
}

# Writes a line about something that went through.
good() {
  printf '%s%s%s\n' "$green" "$*" "$plain"
}

# Writes a line about something that failed.
bad() {
  printf '%s%s%s\n' "$red" "$*" "$plain" >&2
}

# Writes the heading of a step.
step() {
  printf '%s== %s%s\n' "$yellow" "$*" "$plain"
}

# Asks for a line and prints the answer, or the default when it is empty; fails when the input ends.
ask() {
  local answer=
  if ! read -r -e -p "$1 " answer; then
    printf '%s' "${2:-}"
    return 1
  fi

  printf '%s' "${answer:-${2:-}}"
}

# Asks a yes or no question until it gets one: yes succeeds, no fails, the end of the input fails with 2, an empty
# answer is the default given.
yes_no() {
  local answer=
  while read -r -e -p "$1 " answer; do
    case ${answer,,} in
      '') [ "$2" = yes ]; return ;;
      y | yes) return 0 ;;
      n | no) return 1 ;;
    esac

    bad "answer y or n"
  done

  return 2
}

# Asks a question that is no unless answered yes.
confirm() {
  yes_no "$1 [y/N]" no
}

# Asks a question that is yes unless answered no, and no when the input ends.
agree() {
  yes_no "$1 [Y/n]" yes
}

# Waits for Enter before the menu comes back.
pause() {
  local answer=
  read -r -p "Press Enter to return to the menu " answer || true
}

# Turns a spinner on the terminal until it is killed.
spin() {
  local frames="|/-\\" i=0
  while true; do
    printf '\r%s reading...' "${frames:i:1}" >&2
    i=$(((i + 1) % 4))
    sleep 0.1
  done
}

# Stops the spinner, drops the keys typed meanwhile and gives the terminal its echo back.
unspin() {
  kill "$spinning" 2> /dev/null
  wait "$spinning" 2> /dev/null
  spinning=
  printf '\r\e[K' >&2
  while read -r -s -t 0.05 -n 1 _; do
    :
  done

  stty "$kept_tty" 2> /dev/null
}

# Runs a command that reads the state and prints what it wrote, on the terminal of a person with a spinner in its place
# and the keys typed meanwhile dropped.
reading() {
  local said code
  if [ -z "$person" ] || [ -n "$spinning" ] || [ ! -t 0 ] || [ ! -t 2 ] || ! kept_tty=$(stty -g 2> /dev/null); then
    "$@"
    return
  fi

  stty -echo 2> /dev/null
  spin &
  spinning=$!
  trap 'unspin; trap - INT; kill -INT "$BASHPID"' INT
  trap 'unspin; trap - TERM; kill -TERM "$BASHPID"' TERM
  said=$("$@" 2>&1)
  code=$?
  unspin
  trap - INT TERM
  if [ -n "$said" ]; then
    printf '%s\n' "$said"
  fi

  return "$code"
}

# Stops unless the script runs as root.
need_root() {
  if [ "$(id -u)" != 0 ]; then
    bad "run amneziageo-server as root"
    exit 1
  fi
}

# Finds the compose project of the panel by the labels of its container.
locate_compose() {
  local found
  if [ -f "$docker_dir/compose.yaml" ] || ! command -v docker > /dev/null 2>&1; then
    return 0
  fi

  found=$(docker ps -a --filter label=com.docker.compose.project=amneziageo-server \
    --format '{{.Label "com.docker.compose.project.working_dir"}}' 2>/dev/null | head -1)
  if [ -n "$found" ] && [ -f "$found/compose.yaml" ]; then
    docker_dir=$found
  fi
}

# Tells how the panel is put on the host: package, docker, container inside the container of the panel, or none.
kind() {
  if [ -n "${AMNEZIAGEO_KIND:-}" ]; then
    printf '%s' "$AMNEZIAGEO_KIND"
  elif [ -n "${AMNEZIAGEO_CONTAINER:-}" ]; then
    printf 'container'
  elif [ -L "$base/current" ] && [ -f "/etc/systemd/system/$unit.service" ]; then
    printf 'package'
  elif [ -f "$docker_dir/compose.yaml" ] && command -v docker > /dev/null 2>&1; then
    printf 'docker'
  else
    printf 'none'
  fi
}

# Stops an item that needs the panel on a host without it.
need_panel() {
  if [ "$(kind)" = none ]; then
    bad "the panel is not on this host: item 1 installs it"
    return 1
  fi
}

# Runs docker compose in the directory of the project.
dcompose() {
  (cd "$docker_dir" && docker compose "$@")
}

# Prints the identifier of the container of the panel.
container_id() {
  dcompose ps -aq panel 2>/dev/null | head -1
}

# Prints the state of the container of the panel: running, exited, restarting or nothing.
container_state() {
  local id
  id=$(container_id)
  if [ -n "$id" ]; then
    docker inspect -f '{{.State.Status}}' "$id" 2>/dev/null
  fi
}

# Prints the identifier of the container the script runs in.
own_container() {
  grep -o '/containers/[0-9a-f]\{64\}/' /proc/self/mountinfo 2> /dev/null | head -1 | cut -d/ -f3
}

# Calls the Docker daemon through its socket and prints its answer.
engine() {
  local method=$1 path=$2 body=${3:-}
  if [ ! -S "$docker_socket" ]; then
    return 1
  fi

  if [ -n "$body" ]; then
    curl -fsS --max-time 30 --unix-socket "$docker_socket" -X "$method" -H 'Content-Type: application/json' \
      -d "$body" "http://docker$path"
  else
    curl -fsS --max-time 30 --unix-socket "$docker_socket" -X "$method" "http://docker$path"
  fi
}

# Prints what the daemon knows of the container the script runs in.
own_inspect() {
  engine GET "/containers/$(own_container)/json" 2> /dev/null
}

# Prints the name of the container the script runs in.
own_name() {
  local name
  name=$(own_inspect | grep -o '"Name":"/[^"]*"' | head -1 | cut -d/ -f2 | tr -d '"')
  printf '%s' "${name:-amneziageo-server-panel-1}"
}

# Prints a label of the container the script runs in.
own_label() {
  own_inspect | grep -o "\"$1\":\"[^\"]*\"" | head -1 | cut -d'"' -f4
}

# Prints the process of the panel the container runs, nothing while the panel is stopped.
panel_pid() {
  local pid
  pid=$(cat "$run_dir/panel.pid" 2> /dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2> /dev/null; then
    printf '%s' "$pid"
  fi
}

# Tells the loop of the container what follows the end of the panel, ends the panel and waits until it is gone.
end_panel() {
  local pid i
  touch "$run_dir/$1"
  pid=$(panel_pid)
  if [ -z "$pid" ]; then
    return 0
  fi

  kill -TERM "$pid"
  for i in $(seq 1 60); do
    if ! kill -0 "$pid" 2> /dev/null; then
      return 0
    fi

    sleep 1
  done

  bad "the panel did not stop in a minute"
  return 1
}

# Prints the log of the container the script runs in, through compose.
container_log() {
  local project service
  project=$(own_label com.docker.compose.project)
  service=$(own_label com.docker.compose.service)
  if [ -z "$project" ] || [ -z "$service" ]; then
    bad "compose did not start this container: docker logs $(own_name) on the host shows its log"
    return 1
  fi

  (cd / && docker-compose -p "$project" logs --no-log-prefix "$@" "$service")
}

# Stops an item that changes the host itself where the script runs in the container of the panel.
host_only() {
  if [ "$(kind)" = container ]; then
    bad "$1 changes the host, the container of the panel does not reach it"
    return 1
  fi
}

# Prints the command that does on the host what the container cannot reach, instead of a plain refusal.
host_command() {
  if [ "$(kind)" = container ]; then
    bad "$1 changes the host, run this on the host:"
    say "  $2"
    return 1
  fi
}

# Prints the Web settings the file of the service hands the panel, for the utility to start from the same.
web_settings() {
  sed -nE "s/^[[:space:]]*(Web__[A-Za-z0-9_]+)=[\"']?([^\"']*)[\"']?[[:space:]]*$/\1=\2/p" "$etc/server.env" 2> /dev/null
}

# Runs a command of the utility where the panel is put on, with no input.
cli() {
  cli_in "$@" < /dev/null
}

# Runs a command of the utility that may ask questions.
cli_in() {
  local tty=-T
  local -a web=()
  if [ -n "${AMNEZIAGEO_CLI:-}" ]; then
    $AMNEZIAGEO_CLI "$@"
    return
  fi

  case $(kind) in
    package)
      mapfile -t web < <(web_settings)
      env "${web[@]}" "$base/AmneziaGeo.Server.Cli" "$@"
      ;;
    container)
      "$base/AmneziaGeo.Server.Cli" "$@"
      ;;
    docker)
      if [ -t 0 ] && [ -t 1 ]; then
        tty=
      fi

      if [ "$(container_state)" = running ]; then
        dcompose exec $tty panel "$base/AmneziaGeo.Server.Cli" "$@"
      else
        dcompose run --rm --no-deps $tty --entrypoint "$base/AmneziaGeo.Server.Cli" panel "$@"
      fi
      ;;
    *)
      bad "the panel is not on this host: item 1 installs it"
      return 1
      ;;
  esac
}

# Prints settings of the panel one per line, for the script to read.
setting() {
  cli panel get "$@" 2>/dev/null | tr -d '\r'
}

# Prints what the panel answers the host about itself, nothing when it does not answer.
health() {
  case $(kind) in
    package | container)
      curl -fsSk --max-time 5 "$(cat "$data/health" 2>/dev/null || echo http://127.0.0.1:8443/api/health)" 2>/dev/null
      ;;
    docker)
      if [ "$(container_state)" = running ]; then
        dcompose exec -T panel sh -c \
          'curl -fsSk --max-time 5 "$(cat /var/lib/amneziageo-server/health 2>/dev/null || echo http://127.0.0.1:8443/api/health)"' < /dev/null 2>/dev/null
      fi
      ;;
  esac
}

# Prints the version the running panel answers with.
running_version() {
  health | sed -n 's/.*"version":"\([^"]*\)".*/\1/p'
}

# Prints the scheme the panel answers the host under.
scheme() {
  local written=
  case $(kind) in
    package | container)
      written=$(cat "$data/health" 2>/dev/null)
      ;;
    docker)
      written=$(dcompose exec -T panel cat /var/lib/amneziageo-server/health < /dev/null 2>/dev/null)
      ;;
  esac

  case $written in
    https:*) printf 'https' ;;
    *) printf 'http' ;;
  esac
}

# Prints running or stopped for the panel.
panel_state() {
  case $(kind) in
    package)
      if systemctl is-active --quiet "$unit"; then
        printf 'running'
      else
        printf 'stopped'
      fi
      ;;
    docker)
      if [ "$(container_state)" = running ]; then
        printf 'running'
      else
        printf 'stopped'
      fi
      ;;
    container)
      if [ -n "$(panel_pid)" ]; then
        printf 'running'
      else
        printf 'stopped'
      fi
      ;;
    *)
      printf 'not installed'
      ;;
  esac
}

# Prints whether the panel starts with the host.
autostart_state() {
  local policy
  case $(kind) in
    package)
      if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
        printf 'on'
      else
        printf 'off'
      fi
      ;;
    docker | container)
      if [ "$(kind)" = container ]; then
        policy=$(own_inspect | sed -n 's/.*"RestartPolicy":{"Name":"\([^"]*\)".*/\1/p')
      else
        policy=$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$(container_id)" 2>/dev/null)
      fi

      if [ -n "$policy" ] && [ "$policy" != no ]; then
        printf 'on'
      else
        printf 'off'
      fi
      ;;
    *)
      printf 'off'
      ;;
  esac
}

# Tells whether the amneziawg module is loaded.
module_loaded() {
  [ -d /sys/module/amneziawg ]
}

# Tells whether the host forwards packets of both families, of IPv4 alone where it carries no IPv6.
forwarding() {
  [ "$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)" = 1 ] || return 1
  [ ! -e /proc/sys/net/ipv6/conf/all/forwarding ] || [ "$(cat /proc/sys/net/ipv6/conf/all/forwarding)" = 1 ]
}

# Tells whether BBR drives TCP on the host.
bbr_on() {
  [ "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)" = bbr ]
}

# Prints the state of BBR as the host runs it.
bbr_state() {
  if bbr_on; then
    printf 'on'
  else
    printf 'off (%s)' "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)"
  fi
}

# Prints the queue discipline new interfaces take, nothing where the host keeps none of its own.
queue_of_host() {
  if [ -e "$qdisc_file" ]; then
    printf ', queue %s' "$(cat "$qdisc_file")"
  fi
}

# Lists the units of the websocket fronts, loaded or only enabled.
front_units() {
  {
    systemctl list-units --all --plain --no-legend 'amneziageo-proxy@*' 2>/dev/null | awk '{print $1}'
    find /etc/systemd/system -name 'amneziageo-proxy@?*.service' -printf '%f\n' 2>/dev/null
  } | grep -v '^$' | sort -u
}

# Prints the line the panel writes about the services it runs for the clients, nothing without one.
services_line() {
  case $(kind) in
    package | container)
      head -1 "$data/services" 2>/dev/null
      ;;
    docker)
      if [ "$(container_state)" = running ]; then
        dcompose exec -T panel head -1 /var/lib/amneziageo-server/services < /dev/null 2>/dev/null
      fi
      ;;
  esac | tr -d '\r'
}

# Counts the websocket fronts that run.
fronts_running() {
  case $(kind) in
    package)
      systemctl list-units --type=service --state=active --plain --no-legend 'amneziageo-proxy@*' 2>/dev/null | wc -l
      ;;
    container)
      grep -lx wstunnel /proc/[0-9]*/comm 2>/dev/null | wc -l
      ;;
    docker)
      if [ "$(container_state)" = running ]; then
        dcompose exec -T panel sh -c 'grep -lx wstunnel /proc/[0-9]*/comm 2>/dev/null | wc -l' < /dev/null 2>/dev/null | tr -d '\r '
      else
        printf '0'
      fi
      ;;
    *)
      printf '0'
      ;;
  esac
}

# Prints the address of the host on its default route.
public_address() {
  ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1
}

# Prints the global IPv6 address of the host on its default route.
public_address6() {
  ip -6 route get 2001:4860:4860::8888 2> /dev/null | sed -n 's/.* src \([0-9a-f:]*\).*/\1/p' | head -1 | grep -E '^[23]'
}

# Prints the port sshd listens on.
ssh_port() {
  local port
  port=$(sshd -T 2>/dev/null | awk '$1 == "port" {print $2; exit}')
  printf '%s' "${port:-22}"
}

# Tells whether ufw guards the host.
ufw_active() {
  if [ "$(kind)" = container ]; then
    nft list chains 2> /dev/null | grep -q 'chain ufw-user-input'
    return
  fi

  command -v ufw > /dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'
}

# Prints the address the panel opens at from outside.
address() {
  local values port path listen domains host
  mapfile -t values < <(setting port path listen domains)
  port=${values[0]:-}
  if [ -z "$port" ]; then
    return 1
  fi

  path=${values[1]:-/}
  listen=${values[2]:-}
  domains=${values[3]:-}
  if [ -n "$domains" ]; then
    host=${domains%%,*}
  elif [ -z "$listen" ]; then
    host=$(public_address)
  elif [ "$listen" = 127.0.0.1 ] || [ "$listen" = ::1 ]; then
    host=127.0.0.1
  else
    host=${listen%%,*}
  fi

  case $host in
    *:*) host="[$host]" ;;
  esac

  printf '%s://%s:%s%s' "$(scheme)" "${host:-<address of the server>}" "$port" "$path"
}

# Writes the ssh command that brings the panel to another computer and the address to open there.
ssh_command() {
  local values port path ssh host
  mapfile -t values < <(setting port path)
  port=${values[0]:-8443}
  path=${values[1]:-/}
  ssh="ssh -N -L $port:127.0.0.1:$port"
  if [ "$(ssh_port)" != 22 ]; then
    ssh="$ssh -p $(ssh_port)"
  fi

  host=$(public_address)
  say "on your computer:"
  say "  $ssh root@${host:-<address of the server>}"
  say "then open $(scheme)://localhost:$port$path"
}

# Writes where the panel opens, and the way through ssh when it keeps to the loopback.
show_address() {
  local where
  where=$(address) || return 1
  good "the panel: $where"
  case $where in
    *://127.0.0.1:*) ssh_command ;;
  esac
}

# Waits up to a minute for the panel to answer and says on which version.
wait_panel() {
  local i version
  for i in $(seq 1 30); do
    version=$(running_version)
    if [ -n "$version" ]; then
      good "the panel answers, version $version"
      return 0
    fi

    sleep 2
  done

  bad "the panel does not answer: item 19 shows its log"
  return 1
}

# Starts the panel and waits until it answers.
start_panel() {
  case $(kind) in
    package) systemctl start "$unit" ;;
    docker) dcompose up -d > /dev/null ;;
    container) rm -f "$run_dir/held" ;;
  esac

  wait_panel
}

# Stops the panel.
stop_panel() {
  case $(kind) in
    package) systemctl stop "$unit" ;;
    docker) dcompose stop panel > /dev/null ;;
    container) end_panel held ;;
  esac
}

# Starts the panel over and waits until it answers.
restart_panel() {
  case $(kind) in
    package) systemctl restart "$unit" ;;
    docker) dcompose restart panel > /dev/null ;;
    container)
      if [ -n "$(panel_pid)" ]; then
        end_panel again || return 1
      else
        rm -f "$run_dir/held"
      fi
      ;;
  esac

  wait_panel
}

# Prints the menu of the release the container of the panel runs.
release_menu() {
  dcompose exec -T panel cat /usr/local/share/amneziageo-server/amneziageo-server < /dev/null 2> /dev/null
}

# Takes the menu of the release the panel runs now, onto a host that has none when told new.
refresh_self() {
  local next=$self.next
  if [ ! -e "$self" ] && [ "${1:-}" != new ]; then
    return 0
  fi

  case $(kind) in
    package)
      if [ -f "$base/current/amneziageo-server" ]; then
        cp "$base/current/amneziageo-server" "$next"
      fi
      ;;
    docker)
      release_menu > "$next"
      ;;
  esac

  if [ -s "$next" ] && bash -n "$next" 2> /dev/null; then
    chmod 755 "$next"
    mv -f "$next" "$self"
  else
    rm -f "$next"
  fi
}

# Puts the menu of the release on the host of a container where the answers ask for it, and takes it off otherwise.
settle_self() {
  if [ "${given[host_menu]:-yes}" = yes ]; then
    refresh_self new
  elif grep -qs '^# Manages the AmneziaGeo server on this host' "$self"; then
    drop_shortcuts
    rm -f "$self"
  fi
}

# Puts the short command the answers name on the host, a link to the menu.
put_shortcut() {
  local name=${given[shortcut]:-} link
  link=${self%/*}/$name
  if [ -z "$name" ] || [ ! -e "$self" ]; then
    return 0
  fi

  if [ "$(readlink "$link")" = "$self" ] || ln -s "$self" "$link" 2> /dev/null; then
    made_shortcut=$name
    good "the short command $name runs amneziageo-server"
  else
    bad "$link is taken: the short command is not put on"
  fi
}

# Takes the short commands that lead to the menu off the host.
drop_shortcuts() {
  local link
  for link in "${self%/*}"/*; do
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$self" ]; then
      rm -f "$link" && say "removed the short command ${link##*/}"
    fi
  done
}

# Opens the menu of the release the container runs in place of this copy on the host, where the two differ.
follow_release() {
  local held
  if [ -n "${AMNEZIAGEO_FOLLOWED:-}" ] || [ "$(kind)" != docker ] || [ ! -f "$self" ] \
    || [ "$(readlink -f "$0")" != "$(readlink -f "$self")" ] || [ "$(container_state)" != running ]; then
    return 0
  fi

  held=$(release_menu)
  if [ -z "$held" ] || [ "$held" = "$(cat "$self")" ]; then
    return 0
  fi

  refresh_self
  if [ "$held" = "$(cat "$self")" ]; then
    export AMNEZIAGEO_FOLLOWED=1
    exec "$self"
  fi
}

# Prints where the database of the panel lies on the host.
data_dir() {
  local found=
  if [ "$(kind)" = docker ]; then
    found=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/var/lib/amneziageo-server"}}{{.Source}}{{end}}{{end}}' \
      "$(container_id)" 2>/dev/null)
  fi

  printf '%s' "${found:-$data}"
}

# Prints the tag of the image the compose project runs.
image_tag() {
  sed -n 's/^AMNEZIAGEO_TAG=//p' "$docker_dir/.env" 2>/dev/null | tail -1
}

# Writes the tag of the image into the .env of the compose project and keeps its other lines.
write_tag() {
  local lines=
  if [ -f "$docker_dir/.env" ]; then
    lines=$(sed "s/^AMNEZIAGEO_TAG=.*/AMNEZIAGEO_TAG=$1/" "$docker_dir/.env")
  fi

  if ! grep -q '^AMNEZIAGEO_TAG=' <<< "$lines"; then
    lines=$lines${lines:+$'\n'}AMNEZIAGEO_TAG=$1
  fi

  printf '%s\n' "$lines" > "$docker_dir/.env"
}

# Prints the image the container of the panel runs, or the one its compose project names.
running_image() {
  local found
  if [ "$(kind)" = container ]; then
    found=$(own_inspect | sed -n 's/.*"Config":{.*"Image":"\([^"]*\)".*/\1/p')
    printf '%s' "${found:-unknown}"
    return 0
  fi

  found=$(docker inspect -f '{{.Config.Image}}' "$(container_id)" 2>/dev/null)
  if [ -z "$found" ]; then
    found=$(dcompose config --images panel 2>/dev/null | head -1)
  fi

  printf '%s' "${found:-$image:$(image_tag)}"
}

# Prints the name of the image the panel runs, without its tag and digest.
panel_repository() {
  local bare
  bare=$(running_image)
  bare=${bare%%@*}
  case ${bare##*/} in
    *:*) bare=${bare%:*} ;;
  esac

  printf '%s' "$bare"
}

# Prints the name the releases give the architecture of the host.
release_arch() {
  case $(uname -m) in
    x86_64 | amd64) printf 'x64' ;;
    aarch64 | arm64) printf 'arm64' ;;
  esac
}

# Prints the tag of the newest release of a channel that carries a signed manifest; fails when GitHub does not answer.
release_tag() {
  local tests=0 list="https://api.github.com/repos/$repo/releases/latest" found
  if [ "$1" = test ]; then
    tests=1
    list="https://api.github.com/repos/$repo/releases?per_page=5"
  fi

  found=$(curl -fsSL --compressed --max-time 12 --retry 4 --retry-delay 1 --retry-max-time 60 "$list" 2>/dev/null) || return 1
  printf '%s' "$found" | python3 -c '
import json, sys
tests = sys.argv[1] == "1"
found = json.load(sys.stdin)
for release in found if isinstance(found, list) else [found]:
    if release.get("draft") or (release.get("prerelease") and not tests):
        continue
    names = {asset.get("name") for asset in release.get("assets", [])}
    if "update.json" in names and "update.json.sig" in names:
        print(release["tag_name"])
        break
' "$tests"
}

# Downloads one file of a release into a directory.
fetch() {
  if ! curl -fsSL --retry 2 -o "$3/$2" "https://github.com/$repo/releases/download/$1/$2"; then
    bad "$2 of $1 did not download"
    return 1
  fi
}

# Tells whether the manifest in a directory is signed with the key of the releases.
signed() {
  printf '%s\n' "$release_key" > "$1/release.pem"
  openssl dgst -sha256 -verify "$1/release.pem" -signature "$1/update.json.sig" "$1/update.json" > /dev/null 2>&1
}

# Prints the version a manifest names.
manifest_version() {
  sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$1" | head -1
}

# Downloads and checks the manifest of the newest release of a channel, printing its version.
manifest() {
  local channel=$1 work=$2 tag
  if ! tag=$(release_tag "$channel"); then
    bad "GitHub did not answer about the releases of the $channel channel; try again in a minute"
    return 1
  fi

  if [ -z "$tag" ]; then
    bad "GitHub names no release on the $channel channel"
    return 1
  fi

  fetch "$tag" update.json "$work" || return 1
  fetch "$tag" update.json.sig "$work" || return 1
  if ! signed "$work"; then
    bad "the manifest of $tag is not signed with the key of the releases"
    return 1
  fi

  printf '%s %s' "$tag" "$(manifest_version "$work/update.json")"
}

# Builds the amneziawg module from the PPA of Amnezia and loads it at boot.
install_module() {
  local suite swap= built=
  apt-get install -y --no-install-recommends dkms gcc make "linux-headers-$(uname -r)" || return 1
  apt-get install -y --no-install-recommends "linux-headers-$(uname -r | cut -d- -f3-)" > /dev/null 2>&1 || true
  install -d -m 755 /etc/apt/keyrings
  curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0x$ppa_key" \
    -o /etc/apt/keyrings/amnezia-ppa.asc || return 1
  if command -v gpg > /dev/null 2>&1 \
    && ! gpg --show-keys --with-colons /etc/apt/keyrings/amnezia-ppa.asc 2>/dev/null | grep -q ":$ppa_key:"; then
    bad "the key of the Amnezia PPA does not carry the fingerprint $ppa_key"
    return 1
  fi

  if [ "$(awk '/MemTotal/ {print $2}' /proc/meminfo)" -lt 1000000 ] && [ -z "$(swapon --show --noheadings 2>/dev/null)" ]; then
    swap=/swap-amneziageo-build
    fallocate -l 512M "$swap" && chmod 600 "$swap" && mkswap "$swap" > /dev/null && swapon "$swap"
  fi

  for suite in noble jammy; do
    printf 'Types: deb\nURIs: https://ppa.launchpadcontent.net/amnezia/ppa/ubuntu/\nSuites: %s\nComponents: main\nSigned-By: /etc/apt/keyrings/amnezia-ppa.asc\n' \
      "$suite" > /etc/apt/sources.list.d/amnezia-ppa.sources
    if apt-get update > /dev/null && apt-get install -y --no-install-recommends amneziawg-dkms; then
      built=1
      break
    fi
  done

  if [ -n "$swap" ]; then
    swapoff "$swap"
    rm -f "$swap"
  fi

  if [ -z "$built" ]; then
    bad "amneziawg-dkms did not install: /var/lib/dkms/amneziawg/*/build/make.log tells why"
    return 1
  fi

  printf 'amneziawg\n' > /etc/modules-load.d/amneziawg.conf
  modprobe amneziawg
}

# Tells whether the kernel takes the advertisements of routers on an interface.
takes_ra() {
  case $(cat "/proc/sys/net/ipv6/conf/$1/accept_ra" 2> /dev/null) in
    1 | 2) return 0 ;;
  esac

  return 1
}

# Prints the interfaces of the IPv6 default route the kernel took from the advertisements of a router.
ra_uplinks() {
  local dev
  for dev in $(ip -6 route show default 2> /dev/null | awk '/ proto ra( |$)/ {for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1)}' | sort -u); do
    if takes_ra "$dev"; then
      printf '%s\n' "$dev"
    fi
  done
}

# Prints the settings of the kernel the endpoints need, the interfaces of the IPv6 route first.
forwarding_lines() {
  local dev
  for dev in $(ra_uplinks); do
    printf 'net/ipv6/conf/%s/accept_ra = 2\n' "$dev"
  done

  printf 'net.ipv4.ip_forward = 1\nnet.ipv6.conf.all.forwarding = 1\n'
}

# Tells whether forwarding is on and comes back the same at boot.
forwarding_kept() {
  forwarding && [ "$(forwarding_lines)" = "$(cat "$forwarding_conf" 2> /dev/null)" ]
}

# Turns forwarding on now and at boot, the interfaces of the IPv6 route still taking it from the router.
forwarding_on() {
  local uplinks
  uplinks=$(ra_uplinks | tr '\n' ' ')
  forwarding_lines > "$forwarding_conf"
  sysctl -p "$forwarding_conf" > /dev/null
  good "forwarding on${uplinks:+, the router still gives ${uplinks% } the IPv6 route}"
}

# Turns BBR with the fq queue on now and at boot.
bbr_enable() {
  modprobe tcp_bbr 2> /dev/null || true
  if ! grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2> /dev/null; then
    bad "the kernel $(uname -r) carries no BBR"
    return 1
  fi

  printf 'tcp_bbr\n' > "$bbr_module"
  {
    if [ -e "$qdisc_file" ]; then
      printf 'net.core.default_qdisc = fq\n'
    fi

    printf 'net.ipv4.tcp_congestion_control = bbr\n'
  } > "$bbr_conf"
  sysctl -p "$bbr_conf" > /dev/null || return 1
  good "BBR on"
}

# Turns BBR off and puts the defaults of the kernel back.
bbr_disable() {
  local others
  rm -f "$bbr_conf" "$bbr_module"
  sysctl -w net.ipv4.tcp_congestion_control=cubic > /dev/null
  if [ -e "$qdisc_file" ]; then
    sysctl -w net.core.default_qdisc=fq_codel > /dev/null
  fi

  others=$(grep -ls 'tcp_congestion_control *= *bbr' /etc/sysctl.conf /etc/sysctl.d/*.conf 2> /dev/null | tr '\n' ' ')
  if [ -n "$others" ]; then
    bad "BBR comes back at boot from $others"
  fi

  good "BBR off"
}

# Puts on what the host needs for the endpoints: the amneziawg module, forwarding and, when asked, BBR.
prepare_host() {
  step "the host"
  apt-get update > /dev/null || return 1
  apt-get install -y --no-install-recommends curl ca-certificates nftables openssl python3 || return 1
  if ! module_loaded && ! modprobe amneziawg 2> /dev/null; then
    install_module || return 1
  fi

  good "amneziawg module loaded"
  if ! forwarding_kept; then
    forwarding_on
  fi

  if [ -n "${seen[docker]:-}" ]; then
    docker_forward
  fi

  if ! bbr_on && answer_yes bbr "Turn BBR on?" yes; then
    bbr_enable
  fi
}

# Tells whether apt can put a package on.
apt_has() {
  apt-cache policy "$1" 2> /dev/null | grep -q 'Candidate: [0-9]'
}

# Prints what of Docker the host lacks for the container of the panel: docker, compose or daemon, nothing for none.
docker_lacks() {
  if ! command -v docker > /dev/null 2>&1; then
    printf 'docker'
  elif ! docker compose version > /dev/null 2>&1; then
    printf 'compose'
  elif ! docker info > /dev/null 2>&1; then
    printf 'daemon'
  fi
}

# Prints the commands that put on what of Docker the host lacks, from the repository of Docker for its system.
docker_hint() {
  local dist=debian suite
  # shellcheck disable=SC1090
  . "$os_release"
  suite=${VERSION_CODENAME:-}
  if [ "${ID:-}" = ubuntu ] || [[ ${ID_LIKE:-} == *ubuntu* ]]; then
    dist=ubuntu
    suite=${UBUNTU_CODENAME:-$suite}
  fi

  if [ "$1" = daemon ]; then
    say "  systemctl enable --now docker"
    return 0
  fi

  if [ "$1" = compose ] && apt_has docker-compose-plugin; then
    say "  apt-get install -y docker-compose-plugin"
    return 0
  fi

  if [ "$1" = compose ] && apt_has docker-compose-v2; then
    say "  apt-get install -y docker-compose-v2"
    return 0
  fi

  say "  install -d -m 755 /etc/apt/keyrings"
  say "  curl -fsSL https://download.docker.com/linux/$dist/gpg -o /etc/apt/keyrings/docker.asc"
  say "  printf 'Types: deb\nURIs: https://download.docker.com/linux/$dist\nSuites: $suite\nComponents: stable\nSigned-By: /etc/apt/keyrings/docker.asc\n' > /etc/apt/sources.list.d/docker.sources"
  say "  apt-get update"
  say "  apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin"
}

# Stops the installation where the host lacks Docker for the container, with the commands that put it on.
need_docker() {
  local lacks
  lacks=$(docker_lacks)
  case $lacks in
    '') return 0 ;;
    docker) bad "Docker is not on this host: the container of the panel needs Docker with compose" ;;
    compose) bad "docker compose does not answer: the container of the panel needs the compose plugin of Docker" ;;
    daemon) bad "the daemon of Docker does not answer" ;;
  esac

  say "put it on as root:"
  docker_hint "$lacks"
  say "then run amneziageo-server install again"
  exit 1
}

# Tells the daemon of Docker in its settings to leave the forwarded packets alone, where its version takes that.
docker_no_drop() {
  local conf=/etc/docker/daemon.json next=/etc/docker/daemon.json.next
  if grep -qs '"ip-forward-no-drop"' "$conf"; then
    return 0
  fi

  install -d -m 755 /etc/docker
  if [ ! -f "$conf" ]; then
    printf '{\n  "ip-forward-no-drop": true\n}\n' > "$next"
  elif ! python3 - "$conf" "$next" 2> /dev/null <<'PY'
import json, sys
with open(sys.argv[1]) as f:
    conf = json.load(f)
conf["ip-forward-no-drop"] = True
with open(sys.argv[2], "w") as f:
    json.dump(conf, f, indent=2)
    f.write("\n")
PY
  then
    rm -f "$next"
    bad "$conf does not read as JSON: \"ip-forward-no-drop\": true goes into it by hand"
    return 0
  fi

  if ! dockerd --validate --config-file "$next" > /dev/null 2>&1; then
    rm -f "$next"
    say "Docker $(docker version --format '{{.Server.Version}}' 2> /dev/null) takes no \"ip-forward-no-drop\": forwarding on at boot keeps it from dropping"
    return 0
  fi

  if [ -f "$conf" ]; then
    cp -p "$conf" "$conf.$(date -u +%Y%m%d-%H%M%S)"
  fi

  mv -f "$next" "$conf"
  good "Docker leaves the forwarded packets alone from its next start"
}

# Tells whether the FORWARD chain of iptables or ip6tables drops what no rule of it lets through.
forward_drops() {
  command -v "$1" > /dev/null 2>&1 && "$1" -S FORWARD 2> /dev/null | grep -qx -- '-P FORWARD DROP'
}

# Lets the packets of the clients past the drop Docker puts on forwarding.
docker_forward() {
  local tool
  docker_no_drop
  if ufw_active; then
    return 0
  fi

  for tool in iptables ip6tables; do
    if forward_drops "$tool"; then
      "$tool" -P FORWARD ACCEPT && good "$tool forwards the packets of the clients again"
    fi
  done
}

# Writes the compose file of the panel the instructions give.
write_compose() {
  cat > "$docker_dir/compose.yaml" <<EOF
name: amneziageo-server

services:
  panel:
    image: $image:\${AMNEZIAGEO_TAG:-latest}
    network_mode: host
    cap_add:
      - NET_ADMIN
    env_file:
      - path: server.env
        required: false
    volumes:
      - $data:/var/lib/amneziageo-server
      - $etc:/etc/amneziageo-server
      - $endpoints:/etc/amnezia/amneziawg
      - /var/run/docker.sock:/var/run/docker.sock
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    restart: unless-stopped
EOF
}

# Downloads the newest release of a channel, checks it against the key of the releases and puts it on as a package.
install_package() {
  local channel=$1 work found tag version file want rc
  step "the package"
  work=$(mktemp -d) || return 1
  found=$(manifest "$channel" "$work") || { rm -rf "$work"; return 1; }
  tag=${found%% *}
  version=${found#* }
  file=amneziageo-server-$version-linux-$(release_arch).tar.gz
  fetch "$tag" "$file" "$work" || { rm -rf "$work"; return 1; }
  want=$(grep -A3 "\"$file\"" "$work/update.json" | sed -n 's/.*"sha256": *"\([0-9a-f]*\)".*/\1/p' | head -1)
  if [ -z "$want" ] || ! (cd "$work" && printf '%s  %s\n' "$want" "$file" | sha256sum -c - > /dev/null 2>&1); then
    bad "$file does not match the manifest of $tag"
    rm -rf "$work"
    return 1
  fi

  rc=0
  tar -xzf "$work/$file" -C "$work" && "$work/amneziageo-server/install.sh" || rc=$?
  rm -rf "$work"
  return $rc
}

# Puts the panel on as a container of the image of the newest release of a channel.
install_container() {
  local channel=$1 work found version
  step "the container"
  work=$(mktemp -d) || return 1
  found=$(manifest "$channel" "$work") || { rm -rf "$work"; return 1; }
  rm -rf "$work"
  version=${found#* }
  mkdir -p "$docker_dir" "$data" "$etc" "$endpoints"
  printf 'AMNEZIAGEO_TAG=%s\n' "$version" > "$docker_dir/.env"
  write_compose
  dcompose pull && dcompose up -d || return 1
  good "the container of $version runs from $docker_dir/compose.yaml"
}

# Tells whether a person answers the questions on a terminal.
on_terminal() {
  [ -t 0 ]
}

# Asks a question of the installation once, an answer given before or in a file of answers standing.
answer() {
  local key=$1 question=$2 default=${3:-} value
  if [ -n "${given[$key]+set}" ]; then
    say "$question: ${given[$key]}"
    return 0
  fi

  value=$(ask "$question${default:+ [$default]}:" "$default") || value=$default
  given[$key]=$value
  if [ ! -t 0 ]; then
    say "$question: $value"
  fi
}

# Asks a yes or no question of the installation once and tells the answer.
answer_yes() {
  local key=$1 question=$2 default=$3 hint='[y/N]' code=0
  if [ -n "${given[$key]+set}" ]; then
    say "$question ${given[$key]}"
  else
    [ "$default" = yes ] && hint='[Y/n]'
    yes_no "$question $hint" "$default" || code=$?
    case $code in
      0) given[$key]=yes ;;
      1) given[$key]=no ;;
      *) given[$key]=$default ;;
    esac

    if [ ! -t 0 ]; then
      say "$question ${given[$key]}"
    fi
  fi

  [ "${given[$key]}" = yes ]
}

# Asks a question of the installation until its answer passes a check, giving up where no one answers.
answer_until() {
  local key=$1 question=$2 default=$3 check=$4
  while true; do
    answer "$key" "$question" "$default"
    if "$check" "${given[$key]}"; then
      return 0
    fi

    unset "given[$key]"
    if ! on_terminal; then
      return 1
    fi
  done
}

# Takes answers of the installation from a file of key=value lines.
load_answers() {
  local key value
  while IFS='=' read -r key value; do
    case $key in
      '' | \#*) continue ;;
    esac

    given[$key]=$value
  done < "$1"
}

# Keeps the answers of the installation for the run after the reboot.
keep_answers() {
  local key
  (
    umask 077
    for key in "${!given[@]}"; do
      printf '%s=%s\n' "$key" "${given[$key]}"
    done > "$answers_file"
  )
}

# Tells whether a word is a port that TCP leaves free on the host.
panel_port_ok() {
  if ! [[ $1 =~ ^[0-9]+$ ]] || [ "$1" -lt 1 ] || [ "$1" -gt 65535 ]; then
    bad "'$1' is not a port"
    return 1
  fi

  if ! port_free tcp "$1"; then
    bad "TCP port $1 is taken on this host"
    return 1
  fi
}

# Tells whether a word is a port that UDP and TCP leave free on the host.
tunnel_port_ok() {
  panel_port_ok "$1" || return 1
  if ! port_free udp "$1"; then
    bad "UDP port $1 is taken on this host"
    return 1
  fi
}

# Tells whether a word may name an interface the host does not carry yet.
interface_ok() {
  if ! [[ $1 =~ ^[A-Za-z0-9_.-]{1,15}$ ]]; then
    bad "'$1' cannot name an interface"
    return 1
  fi

  if ip link show "$1" > /dev/null 2>&1 || [ -e "$endpoints/$1.conf" ]; then
    bad "the host already carries an interface $1"
    return 1
  fi
}

# Tells whether a word may name a client.
client_ok() {
  if [ -n "$1" ] && ! [[ $1 =~ ^[A-Za-z0-9_.-]{1,32}$ ]]; then
    bad "'$1' cannot name a client: letters, digits, dots, dashes and underscores"
    return 1
  fi
}

# Tells whether a word can name a short command of the menu: a name no command holds, or a link to the menu already.
shortcut_ok() {
  local link=${self%/*}/$1 taken
  if ! [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]]; then
    bad "'$1' cannot name a command: letters, digits, dots, dashes and underscores"
    return 1
  fi

  if [ "$link" = "$self" ]; then
    taken=$self
  elif [ "$(readlink "$link")" = "$self" ]; then
    return 0
  elif [ -e "$link" ] || [ -L "$link" ]; then
    taken=$link
  elif compgen -b -k -- "$1" | grep -qxF -- "$1"; then
    taken="a command of the shell"
  else
    taken=$(type -P "$1")
  fi

  if [ -n "$taken" ]; then
    bad "$1 is taken: $taken"
    return 1
  fi
}

# Tells whether a word is a name or an address clients can reach.
host_ok() {
  if ! [[ $1 =~ ^[A-Za-z0-9.:-]+$ ]]; then
    bad "'$1' is neither a name nor an address"
    return 1
  fi
}

# Tells whether a word is empty or a name the resolver knows.
domain_ok() {
  if [ -n "$1" ] && ! getent ahostsv4 "$1" > /dev/null 2>&1; then
    bad "$1 does not resolve"
    return 1
  fi
}

# Tells whether a word is empty or looks like an email address.
email_ok() {
  if [ -n "$1" ] && ! [[ $1 =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]]; then
    bad "'$1' is not an email address"
    return 1
  fi
}

# Tells whether a word is empty or a backup the panel can be put on.
backup_ok() {
  local said
  if [ -z "$1" ]; then
    return 0
  fi

  said=$(check_copy "$1")
  if [ "$said" != ok ]; then
    bad "$1: $said"
    return 1
  fi
}

# Tells whether a word names a directory of its own for the compose project of the panel: absolute, new or empty.
compose_dir_ok() {
  if ! [[ $1 =~ ^/[^[:space:]]*$ ]]; then
    bad "'$1' is not an absolute path"
    return 1
  fi

  if [ -e "$1" ] && [ ! -d "$1" ]; then
    bad "$1 is not a directory"
    return 1
  fi

  if [ -d "$1" ] && [ -n "$(ls -A "$1" 2> /dev/null)" ]; then
    bad "$1 holds files already: the project of the panel takes a directory of its own"
    return 1
  fi
}

# Tells whether a port of a protocol is free on the host.
port_free() {
  [ -z "$(ss -Hln"${1:0:1}" "sport = :$2" 2> /dev/null)" ]
}

# Prints the first port from a number on that the protocols named leave free.
free_port() {
  local port=$1 protocol busy
  while [ "$port" -le 65535 ]; do
    busy=
    for protocol in "${@:2}"; do
      port_free "$protocol" "$port" || busy=1
    done

    if [ -z "$busy" ]; then
      printf '%s' "$port"
      return 0
    fi

    port=$((port + 1))
  done
}

# Prints a range of unique local IPv6 addresses for the clients of an interface, its first address the interface's.
ula_range() {
  local -a bytes
  read -r -a bytes < <(od -An -N5 -tu1 /dev/urandom)
  printf 'fd%02x:%x:%x::1/64' "${bytes[0]}" $((bytes[1] * 256 + bytes[2])) $((bytes[3] * 256 + bytes[4]))
}

# Prints the first name of an interface from a stem on that neither the host nor its files carry.
free_interface() {
  local number=0
  while ip link show "$1$number" > /dev/null 2>&1 || [ -e "$endpoints/$1$number.conf" ]; do
    number=$((number + 1))
  done

  printf '%s%s' "$1" "$number"
}

# Prints the first name of a short command no command holds: the name given, else it with a number after it.
free_shortcut() {
  local name=$1 number=1
  while ! shortcut_ok "$name" 2> /dev/null; do
    name=$1$number
    number=$((number + 1))
  done

  printf '%s' "$name"
}

# Prints the sockets that listen past the loopback as "protocol port process", the kernel for a tunnel.
listeners() {
  {
    ss -Hltnp 2> /dev/null | awk '{print "tcp", $4, $6}'
    ss -Hlunp 2> /dev/null | awk '{print "udp", $4, $6}'
  } | awk '$2 !~ /^(127\.|\[::1\]|::1)/ {
      port = $2
      sub(/.*:/, "", port)
      name = "kernel"
      if (match($3, /"[^"]+"/)) {
        name = substr($3, RSTART + 1, RLENGTH - 2)
      }
      print $1, port, name
    }' | sort -u | sort -k1,1 -k2,2n
}

# Prints the kernels the host boots, the newest last.
kernels() {
  local file
  for file in /boot/vmlinuz-*; do
    if [ -e "$file" ]; then
      printf '%s\n' "${file#/boot/vmlinuz-}"
    fi
  done | sort -V
}

# Tells whether the host waits for a reboot, into a newer kernel or after an upgrade.
reboot_pending() {
  local newest
  newest=$(kernels | tail -1)
  [ -f /var/run/reboot-required ] || { [ -n "$newest" ] && [ "$newest" != "$(uname -r)" ]; }
}

# Prints on when Secure Boot guards the host, off otherwise.
secure_boot() {
  local var
  for var in /sys/firmware/efi/efivars/SecureBoot-*; do
    if [ -e "$var" ] && [ "$(od -An -t u1 -j 4 -N 1 "$var" 2> /dev/null | tr -d ' ')" = 1 ]; then
      printf 'on'
      return 0
    fi
  done

  printf 'off'
}

# Prints the certificates of Let's Encrypt on the host that hold for a day more, as "name last-day".
certificates() {
  local live end
  for live in /etc/letsencrypt/live/*/; do
    if [ -f "$live/fullchain.pem" ] && openssl x509 -checkend 86400 -noout -in "$live/fullchain.pem" > /dev/null 2>&1; then
      end=$(openssl x509 -enddate -noout -in "$live/fullchain.pem" | cut -d= -f2)
      printf '%s %s\n' "$(basename "$live")" "$(date -d "$end" +%F 2> /dev/null || printf '%s' "$end")"
    fi
  done
}

# Tells whether a name points at an address of this host.
points_here() {
  local address
  for address in $(getent ahostsv4 "$1" 2> /dev/null | awk '{print $1}' | sort -u); do
    if [ "$address" = "${seen[ipv4]:-}" ] || ip -4 -o addr show 2> /dev/null | grep -q " $address/"; then
      return 0
    fi
  done

  return 1
}

# Prints the address clients reach the server at, empty when the host cannot tell it.
client_address() {
  if [ -n "$server_name" ]; then
    printf '%s' "$server_name"
    return 0
  fi

  case ${seen[ipv4]:-} in
    '' | 10.* | 127.* | 169.254.* | 192.168.* | 172.1[6-9].* | 172.2[0-9].* | 172.3[01].*) ;;
    100.6[4-9].* | 100.[7-9][0-9].* | 100.1[01][0-9].* | 100.12[0-7].*) ;;
    *) printf '%s' "${seen[ipv4]}" ;;
  esac
}

# Reads what the host carries before the installation, prints it and stops on what the panel cannot live with.
assess_host() {
  local memory swap tunnels certs
  # shellcheck disable=SC1090
  . "$os_release"
  seen[virt]=$(systemd-detect-virt 2> /dev/null)
  seen[box]=$(systemd-detect-virt -c 2> /dev/null)
  seen[ipv4]=$(public_address)
  seen[ipv6]=$(public_address6)
  memory=$(awk '/^MemTotal/ {print int($2 / 1024)}' /proc/meminfo)
  swap=$(awk '/^SwapTotal/ {print int($2 / 1024)}' /proc/meminfo)
  seen[disk]=$(df -Pm / 2> /dev/null | awk 'NR == 2 {print $4}')
  if module_loaded; then
    seen[module]="loaded $(cat /sys/module/amneziawg/version 2> /dev/null)"
  elif modinfo amneziawg > /dev/null 2>&1; then
    seen[module]=built
  else
    seen[module]=missing
  fi

  if [ -d "/lib/modules/$(uname -r)/build" ]; then
    seen[headers]=installed
  elif apt-cache policy "linux-headers-$(uname -r)" 2> /dev/null | grep -q 'Candidate: [0-9]'; then
    seen[headers]="in apt"
  else
    seen[headers]=missing
  fi

  seen[upgrades]=$(apt-get -s -o Debug::NoLocking=1 dist-upgrade 2> /dev/null | grep -c '^Inst ')
  seen[docker]=
  seen[containers]=
  seen[leftover]=
  if command -v docker > /dev/null 2>&1; then
    seen[docker]=$(docker version --format '{{.Server.Version}}' 2> /dev/null)
    seen[containers]=$(docker ps --format '{{.Names}}' 2> /dev/null | grep -v '^amneziageo-server-' | tr '\n' ' ')
    seen[containers]=${seen[containers]% }
    seen[leftover]=$(docker ps -a --filter label=com.docker.compose.project=amneziageo-server \
      --format '{{.Names}} ({{.Status}})' 2> /dev/null | head -1)
  fi

  if ! command -v ufw > /dev/null 2>&1; then
    seen[ufw]=missing
  elif ufw status 2> /dev/null | grep -q '^Status: active'; then
    seen[ufw]=active
  else
    seen[ufw]=inactive
  fi

  seen[drop]=
  if [ "${seen[ufw]}" != active ] && { forward_drops iptables || forward_drops ip6tables; }; then
    seen[drop]=yes
  fi

  tunnels=$({ ip -o link show type amneziawg; ip -o link show type wireguard; } 2> /dev/null | awk -F': ' '{print $2}' | tr '\n' ' ')
  seen[wstunnel]=
  if [ -x /usr/local/bin/wstunnel ]; then
    seen[wstunnel]=$(/usr/local/bin/wstunnel --version 2> /dev/null | head -1)
    seen[wstunnel]=${seen[wstunnel]:-a binary}
  fi
  certs=$(certificates | awk '{printf "%s%s until %s", (NR > 1 ? ", " : ""), $1, $2}')
  step "the host"
  say "system        ${PRETTY_NAME:-unknown}, $(uname -m)${seen[virt]:+, ${seen[virt]}}"
  say "kernel        $(uname -r), headers ${seen[headers]}, ${seen[upgrades]} upgrades wait$(reboot_pending && printf ', a reboot is pending')"
  say "memory        $memory MB, swap $swap MB, ${seen[disk]} MB free on /"
  say "module        amneziawg ${seen[module]}"
  say "network       forwarding $(forwarding && printf on || printf off), BBR $(bbr_state), IPv4 ${seen[ipv4]:-none}, IPv6 ${seen[ipv6]:-none}"
  say "docker        ${seen[docker]:-none}${seen[containers]:+, containers: ${seen[containers]}}${seen[drop]:+, drops forwarded packets}"
  say "firewall      ufw ${seen[ufw]}$(grep -qs '^IPV6=no' /etc/default/ufw && printf ', IPv6 unguarded: IPV6=no in /etc/default/ufw')"
  say "listening     $(listeners | awk '{printf "%s%s/%s %s", (NR > 1 ? ", " : ""), $2, $1, $3}')"
  say "tunnels       ${tunnels:-none}${seen[wstunnel]:+, /usr/local/bin/wstunnel: ${seen[wstunnel]}}"
  say "certificates  ${certs:-none}"
  if [ -n "${seen[leftover]}" ]; then
    say "a container of an earlier panel stays: ${seen[leftover]}, the new one takes its place"
  fi

  if [ -z "$(release_arch)" ]; then
    bad "there are no releases for $(uname -m)"
    return 1
  fi

  if ! grep -qsE '^ID(_LIKE)?=.*(debian|ubuntu)' "$os_release"; then
    bad "the installer knows Debian and Ubuntu"
    confirm "Go on anyway?" || return 1
  fi

  if [ -n "${seen[box]}" ] && [ "${seen[box]}" != none ] && ! module_loaded; then
    bad "the host is a ${seen[box]} container: the amneziawg module has to be loaded on the host under it"
    return 1
  fi

  if [ "${seen[module]}" = missing ] && [ "$(secure_boot)" = on ]; then
    bad "Secure Boot is on: the module DKMS builds loads once its key is enrolled: mokutil --import /var/lib/dkms/mok.pub, a reboot, MOK Manager"
  fi

  if [ "${seen[module]}" = missing ] && [ "${seen[headers]}" = missing ]; then
    bad "apt carries no headers of the kernel $(uname -r): the module builds after an upgrade and a reboot"
  fi

  if [ "${seen[disk]:-0}" -lt 2048 ]; then
    bad "${seen[disk]} MB free on /: the panel and its image want about 2 GB"
  fi
}

# Prints the ports the answers open to the world, like 8443/tcp.
planned_ports() {
  local ports=()
  if [ -n "${given[domain]:-}" ] || [ "${given[everywhere]:-no}" = yes ]; then
    ports+=("${given[port]}/tcp")
  fi

  if [ "${given[certificate]:-none}" = new ]; then
    ports+=(80/tcp)
  fi

  if [ "${given[endpoint]:-no}" = yes ]; then
    ports+=("${given[endpoint_port]}/udp" "${given[endpoint_port]}/tcp")
  fi

  printf '%s' "${ports[*]}"
}

# Prints the first interface whose clients ufw is to let through for the container, which gives ufw no rules.
routed_interface() {
  if [ "${given[kind]:-}" = docker ] && [ "${given[endpoint]:-no}" = yes ]; then
    printf '%s' "${given[endpoint_name]}"
  fi
}

# Prints the rules of ufw past the ports that the clients of the first interface need, one a line.
interface_rules() {
  local name
  name=$(routed_interface)
  if [ -z "$name" ]; then
    return 0
  fi

  printf 'route allow in on %s\n' "$name"
  printf 'route allow out on %s\n' "$name"
  if [ "${given[resolver]:-no}" = yes ]; then
    printf 'allow in on %s to any port 53 proto udp\n' "$name"
    printf 'allow in on %s to any port 53 proto tcp\n' "$name"
  fi
}

# Prints the ports of the host the installation gave the panel and its first interface.
held_ports() {
  printf 'TCP %s the panel' "${given[port]:-}"
  if [ "${given[endpoint]:-no}" = yes ]; then
    printf ', UDP %s and TCP %s the interface %s' "${given[endpoint_port]}" "${given[endpoint_port]}" "${given[endpoint_name]}"
  fi
}

# Prints what the installation made of the IPv6 of the host.
ipv6_line() {
  if [ -z "${seen[ipv6]:-}" ]; then
    printf 'none on the host, the clients go without it'
  else
    printf '%s, forwarded' "${seen[ipv6]}"
    if [ -n "${given[ipv6_range]:-}" ]; then
      printf ', the clients of %s in %s' "${given[endpoint_name]}" "${given[ipv6_range]}"
    fi
  fi
}

# Asks for a name of the server and what its certificate needs, keeping a certificate the host holds for it.
ask_certificate() {
  local name suggested
  suggested=$(certificates | while read -r name _; do
    if points_here "$name"; then
      printf '%s' "$name"
      break
    fi
  done)
  answer_until domain "Name of the server for a certificate of Let's Encrypt, empty for none" "$suggested" domain_ok || return 1
  name=${given[domain]}
  server_name=$name
  given[certificate]=none
  if [ -z "$name" ]; then
    return 0
  fi

  if certificates | awk -v name="$name" '$1 == name {found = 1} END {exit !found}'; then
    given[certificate]=keep
    return 0
  fi

  if ! port_free tcp 80; then
    bad "TCP port 80 is taken by $(listeners | awk '$1 == "tcp" && $2 == 80 {print $3; exit}'): certbot answers Let's Encrypt on it, the panel goes on without a certificate"
    given[domain]=
    return 0
  fi

  if ! points_here "$name"; then
    bad "$name points at $(getent ahostsv4 "$name" | awk '{print $1; exit}'), not at an address of this host: Let's Encrypt reaches it through a forward of TCP 80 alone"
  fi

  answer_until email "Email for Let's Encrypt, empty for none" "" email_ok || return 1
  if answer_yes terms "Agree to the terms of Let's Encrypt, https://letsencrypt.org/repository/?" yes; then
    given[certificate]=new
  else
    given[domain]=
  fi
}

# Asks for a short command of the menu on the host, none where no one answers on a terminal.
ask_shortcut() {
  if [ -z "${given[shortcut]+set}" ] && { ! on_terminal || ! agree "Put a short command for amneziageo-server on the host?"; }; then
    given[shortcut]=
  fi

  if [ -n "${given[shortcut]+set}" ] && [ -z "${given[shortcut]}" ]; then
    return 0
  fi

  answer_until shortcut "Name of the short command" "$(free_shortcut ag-s)" shortcut_ok || given[shortcut]=
}

# Asks everything the installation needs before it changes anything.
ask_installation() {
  local opening routed
  step "questions"
  if [ -z "${given[kind]+set}" ]; then
    say "  1. Package"
    say "  2. Docker"
  fi

  answer kind "Install as" "$([ -n "${seen[docker]}" ] && printf 2 || printf 1)"
  case ${given[kind]} in
    2 | docker) given[kind]=docker ;;
    *) given[kind]=package ;;
  esac

  if [ "${given[kind]}" = docker ]; then
    need_docker
    answer_until docker_dir "Directory for compose.yaml" "$docker_dir" compose_dir_ok || return 1
    docker_dir=${given[docker_dir]}
    answer_yes host_menu "Put the command amneziageo-server on the host, to run the menu and the utility without entering the container?" yes || true
  fi

  if [ "${given[kind]}" = package ] || [ "${given[host_menu]:-yes}" = yes ]; then
    ask_shortcut
  else
    given[shortcut]=
  fi

  if [ "${given[stage]:-}" != upgraded ]; then
    answer_yes upgrade "Upgrade the system first (apt full-upgrade, ${seen[upgrades]:-0} packages)?" yes || true
  fi

  if [ -z "${given[channel]+set}" ]; then
    say "  1. Stable"
    say "  2. Test"
  fi

  answer channel "Channel" 1
  case ${given[channel]} in
    2 | test | beta) given[channel]='test' ;;
    *) given[channel]='stable' ;;
  esac

  answer_until restore "Backup file to restore, empty for a fresh panel" "" backup_ok || return 1
  if ! bbr_on; then
    answer_yes bbr "Turn BBR on?" yes || true
  fi

  if [ -n "${given[restore]}" ]; then
    return 0
  fi

  answer_until login "Login of the first administrator" admin first_login_ok || return 1
  answer_yes generate "Make up a temporary password for it, replaced at the first sign-in?" yes || true
  ask_certificate || return 1
  answer_until port "Port of the panel" "$(free_port 8443 tcp)" panel_port_ok || return 1
  if [ -z "${given[domain]}" ]; then
    answer_yes everywhere "Let the panel answer on every address of the host, without TLS?" no || true
  fi

  if answer_yes endpoint "Make the first interface?" yes; then
    answer_until endpoint_name "Name of the interface" "$(free_interface awg)" interface_ok || return 1
    answer_until endpoint_port "UDP port of the interface, its services on TCP of the same number" \
      "$(free_port 51820 udp tcp)" tunnel_port_ok || return 1
    if [ -z "${given[endpoint_host]:-}" ]; then
      given[endpoint_host]=$(client_address)
    fi

    if [ -z "${given[endpoint_host]}" ] || ! host_ok "${given[endpoint_host]}"; then
      unset 'given[endpoint_host]'
      answer_until endpoint_host "Address clients reach the server at" "" host_ok || return 1
    fi

    answer_yes websocket "Carry the tunnel in a websocket too, on TCP ${given[endpoint_port]}?" no || true
    answer_until client "Name of the first client, empty for none" client1 client_ok || return 1
    if [ -n "${given[client]}" ]; then
      answer_yes qr "Show its configuration as a QR code, putting qrencode on?" yes || true
    fi

    answer_yes resolver "Answer the DNS of its clients on this server, asking outside over HTTPS?" yes || true
    if [ -n "${seen[ipv6]:-}" ] && [ -z "${given[ipv6_range]+set}" ]; then
      given[ipv6_range]=$(ula_range)
    fi
  fi

  opening=$(planned_ports)
  routed=$(routed_interface)
  if [ "${seen[ufw]}" = active ]; then
    if [ -n "$opening" ]; then
      answer_yes ufw "Open $opening in ufw${routed:+, letting the clients of $routed through}?" yes || true
    fi
  else
    if [ -z "${given[ufw_others]+set}" ]; then
      given[ufw_others]=$(listeners | awk -v ssh="$(ssh_port)" '!($1 == "tcp" && $2 == ssh) {print $2 "/" $1}' | sort -u | tr '\n' ' ')
      given[ufw_others]=${given[ufw_others]% }
    fi

    answer_yes ufw "Turn ufw on, letting in $(ssh_port)/tcp for ssh${opening:+, $opening}${given[ufw_others]:+ and what listens now: ${given[ufw_others]}}${routed:+, the clients of $routed through}?" \
      "$([ "${seen[ufw]}" = missing ] && printf yes || printf no)" || true
  fi
}

# Prints what the installation is going to do.
plan() {
  local uplinks routed
  step "the plan"
  if [ "${given[upgrade]:-no}" = yes ] && [ "${given[stage]:-}" != upgraded ]; then
    say "- upgrade the system; with a new kernel reboot, and the same command goes on after it"
  fi

  if ! module_loaded; then
    say "- build the amneziawg module from the PPA of Amnezia"
  fi

  if ! forwarding_kept; then
    uplinks=$(ra_uplinks | tr '\n' ' ')
    say "- turn forwarding on, now and at boot${uplinks:+, ${uplinks% } still taking the IPv6 route from the router}"
  fi

  if [ "${given[bbr]:-no}" = yes ]; then
    say "- turn BBR on"
  fi

  if [ -n "${seen[docker]}" ] && ! grep -qs '"ip-forward-no-drop"' /etc/docker/daemon.json; then
    say "- add \"ip-forward-no-drop\": true to /etc/docker/daemon.json, where Docker takes it"
  fi

  if [ -n "${seen[docker]}" ] && [ -n "${seen[drop]}" ]; then
    say "- let the packets of the clients past the drop Docker put on forwarding"
  fi

  if [ "${given[kind]}" = docker ]; then
    say "- write $docker_dir/compose.yaml"
    if [ "${given[host_menu]:-yes}" = yes ]; then
      say "- put the menu of the release on the host as $self"
    elif [ -e "$self" ]; then
      say "- take $self off the host: the menu opens in the container"
    fi
  fi

  say "- put the panel on as a ${given[kind]} of the newest ${given[channel]} release"
  if [ -n "${given[shortcut]:-}" ]; then
    say "- put the short command ${given[shortcut]} on the host, a link to $self"
  fi

  if [ -n "${given[restore]}" ]; then
    say "- put the backup ${given[restore]} in place of its database"
    return 0
  fi

  if [ "${given[generate]}" = yes ]; then
    say "- make the administrator ${given[login]} with a temporary password"
  else
    say "- make the administrator ${given[login]}, the password typed then"
  fi

  if [ "${given[host_admin]:-no}" = yes ]; then
    say "- let the user ${given[login]} of the host into the groups amneziageo and amneziageo-admin"
  fi

  case ${given[certificate]} in
    new) say "- get a certificate of Let's Encrypt for ${given[domain]}, renewed by certbot.timer" ;;
    keep) say "- take the certificate the host holds for ${given[domain]}" ;;
  esac

  if [ -n "${given[domain]}" ] || [ "${given[everywhere]}" = yes ]; then
    say "- the panel answers on TCP ${given[port]} on every address$([ -n "${given[domain]}" ] && printf ' under TLS')"
  else
    say "- the panel answers on 127.0.0.1:${given[port]}, through ssh"
  fi

  if [ "${given[endpoint]}" = yes ]; then
    if [ "${given[resolver]:-no}" = yes ]; then
      say "- answer the DNS of the clients on the server, which asks outside over HTTPS"
    fi

    say "- make the interface ${given[endpoint_name]} on UDP ${given[endpoint_port]} for ${given[endpoint_host]}$([ "${given[websocket]}" = yes ] && printf ', with a websocket')"
    if [ -n "${given[ipv6_range]:-}" ]; then
      say "- give its clients IPv6 through the server, from ${given[ipv6_range]}"
    fi
    if [ -n "${given[client]}" ]; then
      say "- make the client ${given[client]} of it, its configuration in /root"
    fi
  fi

  if [ "${given[ufw]:-no}" = yes ]; then
    if [ "${seen[ufw]}" = active ]; then
      say "- open $(planned_ports) in ufw"
    else
      say "- turn ufw on with $(ssh_port)/tcp $(planned_ports) ${given[ufw_others]:-}"
    fi

    routed=$(routed_interface)
    if [ -n "$routed" ]; then
      say "- let the clients of $routed through ufw$([ "${given[resolver]:-no}" = yes ] && printf ', and their DNS to the server')"
    fi
  fi
}

# Upgrades the system and stops for a reboot when a new kernel comes, to go on after it.
upgrade_system() {
  if [ "${given[upgrade]:-no}" != yes ] || [ "${given[stage]:-}" = upgraded ]; then
    return 0
  fi

  step "the system"
  apt-get update > /dev/null || return 1
  DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
    full-upgrade || return 1
  given[stage]=upgraded
  if ! reboot_pending; then
    return 0
  fi

  keep_answers
  say "the host boots into a new kernel, and the module is built for that one"
  say "after the reboot run amneziageo-server install again: it goes on with these answers"
  if answer_yes reboot "Reboot now?" yes; then
    reboot
  fi

  exit 0
}

# Takes the login of the first administrator: a user of the host under it becomes the administrator standing for it,
# once agreed.
first_login_ok() {
  if [ "${given[kind]}" != package ] || ! getent passwd "$1" > /dev/null 2>&1; then
    given[host_admin]=no
    return 0
  fi

  say "The host carries a user $1: an administrator of the panel under that name joins the groups amneziageo and"
  say "amneziageo-admin of the host and signs in to the panel with a password."
  if answer_yes host_admin "Make $1 an administrator of the panel?" yes; then
    return 0
  fi

  unset 'given[host_admin]'
  bad "$1 stays the user of the host alone: the first administrator needs another login"
  return 1
}

# Makes the first administrator of a fresh panel, with a temporary password made up unless one is typed.
first_admin() {
  local said
  local -a make=(init --user "${given[login]}")
  if [ "${given[host_admin]:-no}" = yes ]; then
    make=(user add "${given[login]}" --role admin --host)
  fi

  if [ "${given[generate]:-no}" != yes ]; then
    cli_in "${make[@]}" --permanent
    return
  fi

  said=$(cli "${make[@]}" --generate | tr -d '\r') || { printf '%s\n' "$said"; return 1; }
  made_password=$(printf '%s\n' "$said" | sed -n 's/^password: //p')
  printf '%s\n' "$said" | grep -v '^password: '
}

# Puts the panel on the port, certificate and addresses of the answers and starts it over on them.
place_panel() {
  local name=${given[domain]:-} live
  step "where the panel answers"
  if [ "${given[port]}" != "$(setting port)" ]; then
    cli panel set --port "${given[port]}" > /dev/null || return 1
  fi

  if [ "${given[certificate]:-none}" = new ] && ! certify "$name" "${given[email]:-}"; then
    bad "no certificate for $name: the panel stays on the loopback, item 22 of the menu gets one later"
    name=
  fi

  if [ -n "$name" ]; then
    live=/etc/letsencrypt/live/$name
    share_certificates || return 1
    cli panel set --certificate "$live/fullchain.pem" --key "$live/privkey.pem" > /dev/null || return 1
  fi

  if [ -n "$name" ] || [ "${given[everywhere]:-no}" = yes ]; then
    if ufw_active; then
      cli panel set --listen all --opened on > /dev/null
    else
      cli panel set --listen all > /dev/null
    fi
  fi

  restart_panel
}

# Prints where the API of the panel answers the host.
panel_api() {
  local url path
  url=$(cat "$(data_dir)/health" 2> /dev/null)
  path=$(setting path)
  path=${path%/}
  printf '%s%s/api' "${url%/api/health}" "$path"
}

# Calls the API of the panel with the token of the installation, the body on the input, and prints its answer.
api_call() {
  local method=$1 path=$2 code body=()
  if [ "$method" != GET ]; then
    body=(-H 'Content-Type: application/json' --data-binary @-)
  fi

  code=$(curl -sSk --max-time 60 -X "$method" -H @"$api_work/auth" "${body[@]}" -o "$api_work/answer" \
    -w '%{http_code}' "$api_base$path") || return 1
  if [ "${code:0:1}" != 2 ]; then
    bad "the panel refused $method $path: $(head -c 300 "$api_work/answer")"
    return 1
  fi

  cat "$api_work/answer"
}

# Prints the JSON of the input with a range added to its addresses.
json_address() {
  python3 -c 'import json, sys
body = json.load(sys.stdin)
body["address"] = list(body.get("address") or []) + [sys.argv[1]]
print(json.dumps(body))' "$1"
}

# Prints the JSON of the input with fields set from name=json pairs.
json_set() {
  python3 -c 'import json, sys
body = json.load(sys.stdin)
for pair in sys.argv[1:]:
    key, value = pair.split("=", 1)
    body[key] = json.loads(value)
print(json.dumps(body))' "$@"
}

# Prints a field of the JSON of the input.
json_get() {
  python3 -c 'import json, sys
value = json.load(sys.stdin).get(sys.argv[1], "")
print(value if isinstance(value, str) else json.dumps(value))' "$1"
}

# Makes the interface and the client of the answers through the API of the panel.
endpoint_calls() {
  local draft body config client said file websocket=false
  if [ "${given[websocket]:-no}" = yes ]; then
    websocket=true
  fi

  draft=$(api_call GET "/configs/draft?name=${given[endpoint_name]}") || return 1
  body=$(json_set "name=\"${given[endpoint_name]}\"" "listenPort=${given[endpoint_port]}" \
    "host=\"${given[endpoint_host]}\"" nat=true opened=true isEnabled=true "webSocket=$websocket" <<< "$draft") || return 1
  if [ -n "${given[ipv6_range]:-}" ]; then
    body=$(json_address "${given[ipv6_range]}" <<< "$body") || return 1
  fi

  config=$(api_call POST /configs <<< "$body" | json_get id) || return 1
  good "the interface ${given[endpoint_name]} runs on UDP ${given[endpoint_port]}"
  first_resolver
  if [ -z "${given[client]:-}" ]; then
    return 0
  fi

  draft=$(api_call GET "/clients/draft?config=$config&name=${given[client]}") || return 1
  body=$(json_set isEnabled=true <<< "$draft") || return 1
  client=$(api_call POST /clients <<< "$body" | json_get id) || return 1
  said=$(api_call GET "/clients/$client/config") || return 1
  file=/root/$(json_get fileName <<< "$said")
  (
    umask 077
    json_get text <<< "$said" > "$file"
  )
  made_client=$file
  made_link=$(json_get link <<< "$said")
  good "the client ${given[client]}: $file"
}

# Makes the first interface and its client through the API of the panel, with a token of the installation.
first_endpoint() {
  local said id rc=0
  if [ "${given[endpoint]:-no}" != yes ]; then
    return 0
  fi

  step "the first interface"
  api_work=$(mktemp -d) || return 1
  said=$(cli token add "installer-$(date +%s)" --role admin --days 1 | tr -d '\r')
  id=$(printf '%s\n' "$said" | sed -n 's/^minted \([0-9]*\) .*/\1/p')
  if [ -z "$id" ]; then
    bad "the panel gave the installation no token"
    rm -rf "$api_work"
    return 1
  fi

  (
    umask 077
    printf 'Authorization: Bearer %s\n' "$(printf '%s\n' "$said" | tail -1)" > "$api_work/auth"
  )
  api_base=$(panel_api)
  endpoint_calls || rc=$?
  cli token revoke "$id" --yes > /dev/null
  rm -rf "$api_work"
  return "$rc"
}

# Turns the resolver of the clients on when the answers ask for it, once the first interface gives it an address.
first_resolver() {
  if [ "${given[resolver]:-no}" != yes ]; then
    return 0
  fi

  cli dns set --enabled on || bad "the resolver was not turned on: item 29 of the menu turns it on"
}

# Tells whether ufw already lets a port in, like 8443/tcp.
ufw_lets() {
  ufw status 2> /dev/null | awk -v port="${1%/*}" -v exact="$1" \
    '($1 == port || $1 == exact) && $2 == "ALLOW" && !/\(v6\)/ {found = 1} END {exit !found}'
}

# Tells whether ufw lets UDP in on a port for what comes in on an interface, by a rule for it or for every interface.
ufw_lets_in() {
  ufw status verbose 2> /dev/null | awk -v name="$1" -v port="$2" '
    function takes(spec,    list, i, range) {
      split(spec, list, ",")
      for (i in list) {
        if (split(list[i], range, ":") == 2) {
          if (range[1] + 0 <= port + 0 && port + 0 <= range[2] + 0) {
            return 1
          }
        } else if (list[i] == port) {
          return 1
        }
      }
      return 0
    }
    /^Status: inactive/ {open = 1}
    /^Default:/ {open = /allow \(incoming\)/}
    /^--/ {rules = 1; next}
    !rules || NF == 0 || /\(v6\)/ || decided {next}
    {
      split($0, part, /  +/)
      target = part[1]
      action = part[2]
      if (action ~ /OUT|FWD/ || part[3] != "Anywhere") {
        next
      }
      at = index(target, " on ")
      if (at > 0) {
        if (substr(target, at + 4) != name) {
          next
        }
        target = substr(target, 1, at - 1)
      }
      split(target, spec, "/")
      if ((spec[2] != "" && spec[2] != "udp") || (target != "Anywhere" && !takes(spec[1]))) {
        next
      }
      decided = 1
      open = action ~ /^(ALLOW|LIMIT)/
    }
    END {exit !open}'
}

# Tells whether ufw was given this very rule already, on or off, whatever its comment.
ufw_holds() {
  ufw show added 2> /dev/null | grep -qxE "ufw $*( comment .*)?"
}

# Opens in ufw the ports of the answers it does not let in yet, turning ufw on first when asked.
guard_host() {
  local port opened=() first=() rule=()
  if [ "${given[ufw]:-no}" != yes ]; then
    return 0
  fi

  step "the firewall"
  if [ "${seen[ufw]}" != active ]; then
    if ! command -v ufw > /dev/null 2>&1; then
      apt-get install -y ufw > /dev/null || return 1
    fi

    read -r -a first <<< "$(ssh_port)/tcp ${given[ufw_others]:-}"
  fi

  for port in "${first[@]}" $(planned_ports); do
    if ! ufw_holds allow "$port" && ! ufw_lets "$port"; then
      ufw allow "$port" > /dev/null && opened+=("$port")
    fi
  done

  while read -r -a rule; do
    if ! ufw_holds "${rule[@]}"; then
      ufw "${rule[@]}" comment "amneziageo ${given[endpoint_name]}" > /dev/null
    fi
  done < <(interface_rules)

  if [ "${seen[ufw]}" != active ]; then
    ufw --force enable > /dev/null || return 1
    if [ "$(kind)" = package ]; then
      restart_panel > /dev/null
    fi
  fi

  good "ufw lets in $(planned_ports)${opened[*]:+, opened now: ${opened[*]}}"
  if [ -n "$(routed_interface)" ]; then
    good "ufw lets the clients of $(routed_interface) through"
  fi
}

# Checks the panel the way the guides do and names what the installation made.
final_check() {
  local values port prefix name=${given[domain]:-}
  step "the check"
  check_status
  mapfile -t values < <(setting port path)
  port=${values[0]:-}
  prefix=${values[1]:-/}
  if [ -n "$name" ] && [ -n "$(setting certificate)" ]; then
    if curl -fsS --max-time 10 --resolve "$name:$port:127.0.0.1" "https://$name:$port/api/health" > /dev/null 2>&1; then
      good "the panel answers under the certificate of $name"
    else
      bad "the panel does not answer https://$name:$port under the certificate of $name"
    fi
  fi

  if [ "${given[endpoint]:-no}" = yes ]; then
    if ip link show "${given[endpoint_name]}" > /dev/null 2>&1; then
      good "the interface ${given[endpoint_name]} is up"
    else
      bad "the interface ${given[endpoint_name]} is not up: item 25 of the menu shows the interfaces"
    fi
  fi

  step "done"
  if [ -n "$name" ] && [ -n "$(setting certificate)" ]; then
    good "the panel: https://$name:$port$prefix"
  else
    show_address
  fi

  if [ -n "$made_password" ]; then
    say "login ${given[login]}, password $made_password: the panel asks for a new one at the first sign-in"
  fi

  if [ -n "$made_client" ]; then
    say "the configuration of ${given[client]}: $made_client"
    if [ "${given[qr]:-no}" = yes ] && [ -n "$made_link" ]; then
      if ! command -v qrencode > /dev/null 2>&1; then
        apt-get install -y qrencode > /dev/null 2>&1
      fi

      qrencode -t ansiutf8 "$made_link" 2> /dev/null || say "the link does not fit a QR code: $made_link"
    elif [ -n "$made_link" ]; then
      say "its link: $made_link"
    fi
  fi

  if [ "${given[kind]}" = docker ]; then
    say "compose: $docker_dir/compose.yaml"
  fi

  say "ports: $(held_ports)"
  say "IPv6: $(ipv6_line)"
  if [ "${given[kind]}" = docker ] && [ "${given[host_menu]:-yes}" != yes ]; then
    say "the menu: docker compose -f $docker_dir/compose.yaml exec panel amneziageo-server"
  else
    say "the menu: amneziageo-server${made_shortcut:+, or $made_shortcut}"
  fi
}

# Item 1: looks the host over, asks everything first, then puts the panel on as a package or a container, fresh or on
# the database of a backup.
install_panel() {
  if [ "$(kind)" != none ]; then
    say "the panel is already on this host as a $(kind): item 2 updates it"
    return 0
  fi

  if [ -f "$answers_file" ] && [ -z "${given[stage]:-}" ]; then
    if agree "An installation stopped for a reboot: go on with its answers?"; then
      load_answers "$answers_file"
    fi

    rm -f "$answers_file"
  fi

  assess_host || return 1
  ask_installation || return 1
  plan
  answer_yes go "Go on?" yes || return 0
  upgrade_system || return 1
  prepare_host || return 1
  if [ "${given[kind]}" = docker ]; then
    install_container "${given[channel]}" || return 1
  else
    install_package "${given[channel]}" || return 1
  fi

  if [ -n "${given[restore]}" ]; then
    step "the backup"
    if [ "${given[kind]}" = docker ]; then
      wait_panel
      settle_self
    fi

    put_shortcut
    restore_copy "${given[restore]}"
    return
  fi

  if [ "${given[kind]}" = docker ]; then
    wait_panel || return 1
    settle_self
  else
    start_panel || return 1
  fi

  put_shortcut

  step "the first administrator"
  first_admin || return 1
  if [ "${given[channel]}" = test ]; then
    cli panel set --channel test > /dev/null
  fi

  place_panel || return 1
  first_endpoint || bad "the interface was not made: item 25 of the menu and the panel make one"
  guard_host || bad "ufw did not take the ports: item 23 of the menu opens them"
  install_doors
  final_check
}

# Items 2 and 3: moves the panel to the newest release of its channel, of the test channel for a beta.
update_panel() {
  local before rc
  need_panel || return 1
  if [ "$(panel_state)" != running ]; then
    bad "the panel does not run: item 15 starts it"
    return 1
  fi

  before=$(running_version)
  if [ "${1:-}" = beta ]; then
    cli update apply --beta
  else
    cli update apply
  fi

  rc=$?
  case $rc in
    0) ;;
    3) return 0 ;;
    *) return 1 ;;
  esac

  if [ "$(kind)" = container ]; then
    say "the container moves to the new release and this session ends; the menu opens again with:"
    say "  docker exec -it $(own_name) amneziageo-server"
  fi

  wait_version "$before"
}

# Waits up to five minutes for the panel to answer on another version.
wait_version() {
  local before=$1 now i
  for i in $(seq 1 150); do
    sleep 2
    now=$(running_version)
    if [ -n "$now" ] && [ "$now" != "$before" ]; then
      printf '\n'
      good "the panel runs $now"
      refresh_self
      return 0
    fi

    printf '.'
  done

  printf '\n'
  bad "the panel did not come back on a new version"
  cli update status
  return 1
}

# Puts a copy of the database back while the panel is stopped, the database it held kept aside.
restore_backup() {
  local dir copies choice picked aside was i
  dir=$(data_dir)
  mapfile -t copies < <(ls -1t "$dir/backup" 2> /dev/null)
  if [ ${#copies[@]} -eq 0 ]; then
    say "there are no copies in $dir/backup"
    return 0
  fi

  for i in "${!copies[@]}"; do
    printf '  %d. %s\n' $((i + 1)) "${copies[$i]}"
  done

  choice=$(ask "Copy to put back:")
  if ! [[ $choice =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt ${#copies[@]} ]; then
    return 0
  fi

  picked=$dir/backup/${copies[$((choice - 1))]}
  confirm "Put $picked back?" || return 0
  was=$(panel_state)
  stop_panel
  aside=$dir/backup/$(date -u +%Y%m%d-%H%M%S)-before-restore
  mkdir -p "$aside"
  cp -a "$dir"/server.db* "$aside/" 2> /dev/null
  rm -f "$dir/server.db-wal" "$dir/server.db-shm"
  cp -a "$picked"/server.db* "$dir/"
  good "put back $picked, the database before it lies in $aside"
  if [ "$was" = running ]; then
    start_panel
  fi
}

# Copies the database aside while the panel is stopped for a moment.
take_backup() {
  local dir target was
  confirm "The panel stops for a moment. Go on?" || return 0
  dir=$(data_dir)
  target=$dir/backup/$(date -u +%Y%m%d-%H%M%S)-by-hand
  was=$(panel_state)
  stop_panel
  mkdir -p "$target"
  cp -a "$dir"/server.db* "$target/" && good "copied the database to $target"
  if [ "$was" = running ]; then
    start_panel
  fi
}

# Offers the copy of the database taken before the last update back.
offer_backup() {
  if confirm "Put back a copy of the database taken before an update too?"; then
    restore_backup
  fi
}

# Prints ok for a sound database of the panel, or what is wrong with it; a database of the host to compare it with
# turns down a backup of a newer release.
check_copy() {
  if [ "$(kind)" = container ]; then
    cli backup check "$1" | tr -d '\r'
    return 0
  fi

  if ! command -v python3 > /dev/null 2>&1; then
    printf 'python3 checks the backup: apt-get install python3'
    return 0
  fi

  python3 - "$1" "${2:-}" <<'EOF'
import os, pathlib, sqlite3, sys

def newest(db):
    try:
        return db.execute("select max(MigrationId) from __EFMigrationsHistory").fetchone()[0] or ""
    except sqlite3.DatabaseError:
        return ""

copy, held = sys.argv[1], sys.argv[2]
if not os.path.isfile(copy):
    print("there is no such file")
    sys.exit()

with open(copy, "rb") as head:
    if head.read(16) != b"SQLite format 3\x00":
        print("not a database")
        sys.exit()

try:
    db = sqlite3.connect(pathlib.Path(copy).resolve().as_uri() + "?mode=ro&immutable=1", uri=True)
    sound = db.execute("pragma integrity_check").fetchone()[0] == "ok"
    tables = {row[0] for row in db.execute("select name from sqlite_master where type = 'table'")}
    mine = newest(db)
    db.close()
except sqlite3.DatabaseError:
    print("the database is damaged")
    sys.exit()

if not {"__EFMigrationsHistory", "Panel", "Configs", "AspNetUsers"} <= tables:
    print("not a database of the panel")
elif not sound:
    print("the database is damaged")
elif held and os.path.isfile(held):
    db = sqlite3.connect(held)
    known = newest(db)
    db.close()
    print("the backup comes from a newer release of the panel, update the panel first" if known and mine > known else "ok")
else:
    print("ok")
EOF
}

# Tells whether the host carries an address the panel listens on.
carried() {
  case $1 in
    127.* | ::1 | 0.0.0.0 | ::) return 0 ;;
  esac

  ip -o addr show 2> /dev/null | awk '{sub(/\/.*/, "", $4); print $4}' | grep -qxF "$1"
}

# Fits the settings of a restored panel to this host: the certificate it lacks, the addresses it does not carry and
# the port of the panel in ufw.
fit_host() {
  local values chain listen opened port name live kept one now list fix=()
  mapfile -t values < <(setting certificate listen opened port)
  chain=${values[0]:-}
  listen=${values[1]:-}
  opened=${values[2]:-}
  port=${values[3]:-}
  if [ -n "$chain" ] && [ ! -f "$chain" ]; then
    bad "the panel answers under $chain, which this host lacks"
    name=$(basename "$(dirname "$chain")")
    name=${name%-[0-9][0-9][0-9][0-9]}
    live=/etc/letsencrypt/live/$name
    if [[ $chain == /etc/letsencrypt/live/* ]] && confirm "Get a Let's Encrypt certificate for $name now? The name has to point at this host"; then
      certify "$name"
    fi

    if [ ! -f "$chain" ] && [[ $chain == /etc/letsencrypt/live/* ]] && [ -f "$live/fullchain.pem" ]; then
      chain=$live/fullchain.pem
      fix+=(--certificate "$chain" --key "$live/privkey.pem")
    elif [ ! -f "$chain" ]; then
      chain=
      fix+=(--certificate none)
      say "the panel answers without a certificate until item 22 gets one"
    fi
  fi

  now=$listen
  if [ -n "$listen" ]; then
    kept=
    IFS=, read -ra list <<< "$listen"
    for one in "${list[@]}"; do
      if carried "$one"; then
        kept=${kept:+$kept,}$one
      else
        bad "this host carries no address $one"
      fi
    done

    if [ -z "$kept" ] && agree "Let the panel answer on every address of the host?"; then
      kept=all
    fi

    if [ "$kept" != "$listen" ]; then
      now=${kept:-127.0.0.1}
      fix+=(--listen "$now")
    fi
  fi

  if ufw_active && [ "$opened" = off ] && [ "$now" != 127.0.0.1 ] && [ "$now" != ::1 ] \
    && agree "Hold TCP port $port open in the firewall?"; then
    fix+=(--opened on)
  fi

  if [ "$(kind)" = docker ] && [[ $chain == /etc/letsencrypt/* ]]; then
    share_certificates stopped || return 1
  fi

  if [ ${#fix[@]} -gt 0 ]; then
    cli panel set "${fix[@]}" > /dev/null || return 1
  fi
}

# Puts a backup downloaded from a panel in place of the database, keeping the database it replaces aside, and starts
# the panel on it.
restore_copy() {
  local file=$1 dir said aside
  dir=$(data_dir)
  if [ ! -f "$dir/server.db" ]; then
    cli panel get port > /dev/null 2>&1
  fi

  said=$(check_copy "$file" "$dir/server.db")
  if [ "$said" != ok ]; then
    bad "$file: $said"
    return 1
  fi

  stop_panel
  aside=$dir/backup/$(date -u +%Y%m%d-%H%M%S)-before-restore
  mkdir -p "$aside"
  cp -a "$dir"/server.db* "$aside/" 2> /dev/null
  rm -f "$dir/server.db-wal" "$dir/server.db-shm"
  install -m 600 "$file" "$dir/server.db" || return 1
  good "restored $file, the database before it lies in $aside"
  fit_host || return 1
  start_panel || return 1
  cli geo update
  show_address
}

# Puts a backup downloaded from a panel on, asking for the file when not given one.
restore_file() {
  local file=${1:-}
  need_panel || return 1
  if [ -z "$file" ]; then
    file=$(ask "Backup file, like /root/amneziageo-<name>-<time>.db:")
  fi

  if [ -z "$file" ]; then
    return 0
  fi

  confirm "The panel stops while $file goes in. Go on?" || return 0
  restore_copy "$file"
}

# Item 4: goes back to the release before the current one.
rollback_panel() {
  local current previous
  need_panel || return 1
  host_only "going back to an older image" || return 1
  if [ "$(kind)" = package ]; then
    if [ ! -L "$base/previous" ]; then
      bad "there is no release to go back to"
      return 1
    fi

    confirm "Go back to $(basename "$(readlink "$base/previous")")?" || return 0
    "$base/current/install.sh" --rollback || return 1
    offer_backup
    return 0
  fi

  current=$(image_tag)
  previous=$(docker images "$(panel_repository)" --format '{{.Tag}}' 2> /dev/null | grep -E '^[0-9]+(\.[0-9]+)+$' \
    | { cat; printf '%s\n' "$current"; } | sort -uV | grep -B1 -x "$current" | head -1)
  if [ -z "$previous" ] || [ "$previous" = "$current" ]; then
    bad "the host keeps no image older than $current"
    return 1
  fi

  confirm "Go back from $current to $previous?" || return 0
  write_tag "$previous"
  dcompose up -d > /dev/null && wait_panel
  offer_backup
}

# Lists the releases the host keeps.
list_releases() {
  case $(kind) in
    package)
      "$base/current/install.sh" --list
      ;;
    container)
      say "the container runs $(running_image)"
      engine GET /images/json 2> /dev/null | grep -o "\"$(panel_repository):[^\"]*\"" | tr -d '"' | sort -uV
      ;;
    *)
      say "the project runs $(running_image)"
      docker images "$(panel_repository)"
      ;;
  esac
}

# Lists the copies of the database.
list_backups() {
  local dir
  dir=$(data_dir)/backup
  if ! ls -1t "$dir" 2> /dev/null | grep -q .; then
    say "there are no copies in $dir"
    return 0
  fi

  say "$dir:"
  du -sh "$dir"/* 2> /dev/null | sort -k2 -r
}

# Sets the channel the panel takes its releases from.
channel_item() {
  local choice channel
  channel=$(reading setting channel)
  say "the panel takes releases from the $channel channel"
  say "  1. Stable"
  say "  2. Test"
  choice=$(ask "Channel:")
  case $choice in
    1) cli panel set --channel stable ;;
    2) cli panel set --channel test ;;
  esac
}

# Puts on the web interface of an unpacked package while the server runs on.
web_package() {
  local dir
  if [ "$(kind)" != package ]; then
    bad "a web interface alone goes on a package, a container takes whole images"
    return 1
  fi

  dir=$(ask "Directory of the unpacked package:")
  if [ ! -x "$dir/install.sh" ]; then
    bad "$dir holds no install.sh"
    return 1
  fi

  "$dir/install.sh" --ui
}

# Item 5: the releases on the host, the copies of the database and the channel.
releases_menu() {
  local choice
  need_panel || return 1
  while true; do
    step "Releases & Backups"
    say "  1. Releases on this host"
    say "  2. Database backups"
    say "  3. Put a database backup back"
    say "  4. Restore a backup file"
    say "  5. Back up the database now"
    say "  6. Release channel"
    say "  7. Look for a new release"
    say "  8. Put on a web interface package"
    say "  0. Back"
    choice=$(ask "Choose:") || return 0
    case $choice in
      1) reading list_releases ;;
      2) list_backups ;;
      3) restore_backup ;;
      4) restore_file ;;
      5) take_backup ;;
      6) channel_item ;;
      7) reading cli update check ;;
      8) web_package ;;
      0 | "") return 0 ;;
      *) bad "there is no item $choice" ;;
    esac
  done
}

# Takes the interfaces, the firewall rules and the tables the panel raised off the host.
clear_host() {
  local name family table number
  for name in "$@"; do
    if ip -d link show "$name" 2> /dev/null | grep -q amneziawg; then
      ip link delete "$name" && say "removed the interface $name"
    fi
  done

  nft list tables 2> /dev/null | awk '$3 ~ /^amneziageo/ {print $2, $3}' | while read -r family table; do
    nft delete table "$family" "$table" && say "removed the table $family $table"
  done

  if command -v ufw > /dev/null 2>&1; then
    while number=$(ufw status numbered 2> /dev/null | grep -m1 '# amneziageo' | sed -n 's/^\[ *\([0-9]*\)\].*/\1/p') \
      && [ -n "$number" ]; do
      ufw --force delete "$number" > /dev/null || break
    done
  fi
}

# Item 6: takes the panel off the host, its database and settings too when asked.
uninstall_panel() {
  local kind names name repository keep=yes
  need_panel || return 1
  host_only "taking the panel off" || return 1
  kind=$(kind)
  confirm "Remove the panel from this host?" || return 0
  if confirm "Remove its database and settings too?"; then
    keep=no
  fi

  names=$(cli endpoint list 2> /dev/null | tr -d '\r' | sed -n 's/^\([^:]*\): port .*/\1/p')
  step "the panel"
  if [ "$kind" = package ]; then
    systemctl disable --now "$unit" 2> /dev/null
    for name in $(front_units); do
      systemctl disable --now "$name" 2> /dev/null
    done

    rm -f "/etc/systemd/system/$unit.service" /etc/systemd/system/amneziageo-proxy@.service
    systemctl daemon-reload
    rm -rf "$base"
    rm -f "$etc"/proxy-*.env
  else
    repository=$(panel_repository)
    if [ "$keep" = no ]; then
      dcompose down -v
    else
      dcompose down
    fi

    if confirm "Remove the images of the panel too?"; then
      { docker images -q "$repository"; docker images -q "$image"; } | sort -u | xargs -r docker rmi -f > /dev/null
    fi
  fi

  step "what the panel raised on the host"
  # shellcheck disable=SC2086
  clear_host $names
  if [ "$keep" = no ]; then
    for name in $names; do
      rm -f "$endpoints/$name.conf"
    done

    rm -rf "$data" "$etc"
    if [ "$kind" = docker ]; then
      rm -rf "$docker_dir"
    fi

    good "removed the database and the settings"
  else
    say "the database stays in $(data_dir), the settings in $etc"
  fi

  say "left on the host: the amneziawg module, $forwarding_conf"
  drop_shortcuts
  rm -f "$self"
  good "the panel is off the host"
  exit 0
}

# Whether the panel of this host takes the login of a user of the host as the name of an account.
