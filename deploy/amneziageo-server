# Lists the firewall and the ports the panel needs open.
firewall_status() {
  local subscriptions kept=()
  if command -v ufw > /dev/null 2>&1; then
    ufw status verbose
  elif [ "$(kind)" = container ]; then
    say "the firewall of the host: $(ufw_active && printf 'ufw active' || printf 'ufw off')"
  else
    say "ufw is not installed, the panel keeps its ports in nftables"
  fi

  nft list tables 2> /dev/null | grep amneziageo
  step "ports the panel needs"
  say "TCP $(ssh_port)  ssh"
  say "TCP $(setting port)  the panel, held open: $(setting opened)"
  mapfile -t subscriptions < <(cli subscriptions get separate port opened 2> /dev/null | tr -d '\r')
  if [ "${subscriptions[0]:-}" = on ]; then
    say "TCP ${subscriptions[1]:-}  the subscriptions, held open: ${subscriptions[2]:-}"
  fi

  cli endpoint list
  if [ -d /etc/letsencrypt/live ]; then
    say "TCP 80  renewals of Let's Encrypt"
  fi

  mapfile -t kept < <(resolver_kept)
  if [ ${#kept[@]} -gt 0 ]; then
    bad "ufw keeps the clients of ${kept[*]} from the resolver: item 13 lets them reach it"
  fi
}

# Prints the nftables tables the panel lays: the routing, the outbounds, the endpoints and the open ports.
firewall_tables() {
  local tables one
  if ! command -v nft > /dev/null 2>&1; then
    bad "nft is not installed on this host: apt-get install nftables"
    return 1
  fi

  mapfile -t tables < <(nft list tables 2> /dev/null | awk '$3 ~ /^amneziageo/ {print $2 " " $3}')
  if [ ${#tables[@]} -eq 0 ]; then
    say "the panel holds no nftables tables"
    return 0
  fi

  for one in "${tables[@]}"; do
    # shellcheck disable=SC2086
    nft list table $one
  done
}

# Opens or closes a port in ufw.
ufw_port() {
  local port
  port=$(ask "Port with its protocol, like 443/tcp:")
  if ! [[ $port =~ ^[0-9]+(/(tcp|udp))?$ ]]; then
    bad "'$port' is not a port"
    return 1
  fi

  if [ "$1" = allow ]; then
    host_command "opening $port" "ufw allow $port" || return 1
  else
    host_command "closing $port" "ufw delete allow $port" || return 1
  fi

  if ! command -v ufw > /dev/null 2>&1; then
    bad "ufw is not installed: item 10 of this menu puts it on"
    return 1
  fi

  if [ "$1" != allow ]; then
    ufw delete allow "$port"
  elif ufw_holds allow "$port" || ufw_lets "$port"; then
    say "ufw lets $port in already"
  else
    ufw allow "$port"
  fi
}

# Turns ufw on with ssh kept open and lets the panel lay its rules.
ufw_on() {
  host_command "turning ufw on" "apt-get install -y ufw; ufw allow <the port of ssh>/tcp; ufw --force enable" || return 1
  if ! command -v ufw > /dev/null 2>&1; then
    agree "ufw is not installed. Install it?" || return 0
    apt-get install -y ufw || return 1
  fi

  if ! ufw_holds allow "$(ssh_port)/tcp" && ! ufw_lets "$(ssh_port)/tcp"; then
    ufw allow "$(ssh_port)/tcp" > /dev/null
  fi

  ufw --force enable
  good "the firewall is on, TCP $(ssh_port) stays open for ssh"
  if [ "$(kind)" != none ]; then
    restart_panel
  fi
}

