#!/usr/bin/env bash
# Manages the AmneziaGeo server on this host: the menu without arguments, its items and the utility as commands.
# AMNEZIAGEO_KIND, AMNEZIAGEO_CLI, AMNEZIAGEO_DATA, AMNEZIAGEO_UNIT and AMNEZIAGEO_DOCKER_DIR move it onto another layout.
set -uo pipefail

repo=bor-project/amneziageo_server
image=ghcr.io/bor-project/amneziageo-server
self=/usr/local/bin/amneziageo-server
base=/opt/amneziageo-server
etc=/etc/amneziageo-server
data=${AMNEZIAGEO_DATA:-/var/lib/amneziageo-server}
unit=${AMNEZIAGEO_UNIT:-amneziageo-server}
docker_dir=${AMNEZIAGEO_DOCKER_DIR:-/opt/amneziageo-docker}
endpoints=/etc/amnezia/amneziawg
run_dir=/run/amneziageo-server
docker_socket=/var/run/docker.sock
forwarding_conf=/etc/sysctl.d/90-amneziageo.conf
bbr_conf=/etc/sysctl.d/91-amneziageo-bbr.conf
bbr_module=/etc/modules-load.d/amneziageo-bbr.conf
qdisc_file=/proc/sys/net/core/default_qdisc
override_mark='# written by amneziageo-server'
ppa_key=75C9DD72C799870E310542E24166F2C257290828
release_key='-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEzgZ6s+M0wvE0HMsFuPhwk7cZsCSY
vbaWhP248NSthVEmlp9mRRjOf9zIFsIZ5P4mM1ETGo+l/Gb+S+7TcwVUew==
-----END PUBLIC KEY-----'

if [ -t 1 ]; then
  red=$'\e[31m'
  green=$'\e[32m'
  yellow=$'\e[33m'
  plain=$'\e[0m'
else
  red=
  green=
  yellow=
  plain=
fi

# Writes a line.
say() {
  printf '%s\n' "$*"
}

# Writes a line about something that went through.
good() {
  printf '%s%s%s\n' "$green" "$*" "$plain"
}

# Writes a line about something that failed.
bad() {
  printf '%s%s%s\n' "$red" "$*" "$plain" >&2
}

# Writes the heading of a step.
step() {
  printf '%s== %s%s\n' "$yellow" "$*" "$plain"
}

# Asks for a line and prints the answer, or the default when it is empty; fails when the input ends.
ask() {
  local answer=
  if ! read -r -p "$1 " answer; then
    printf '%s' "${2:-}"
    return 1
  fi

  printf '%s' "${answer:-${2:-}}"
}

# Asks a question that is no unless answered yes.
confirm() {
  local answer=
  read -r -p "$1 [y/N] " answer || true
  [[ $answer == [yY]* ]]
}

# Asks a question that is yes unless answered no, and no when the input ends.
agree() {
  local answer=
  if ! read -r -p "$1 [Y/n] " answer; then
    return 1
  fi

  [[ -z $answer || $answer == [yY]* ]]
}

# Waits for Enter before the menu comes back.
pause() {
  local answer=
  read -r -p "Press Enter to return to the menu " answer || true
}

# Stops unless the script runs as root.
need_root() {
  if [ "$(id -u)" != 0 ]; then
    bad "run amneziageo-server as root"
    exit 1
  fi
}

# Finds the compose project of the panel by the labels of its container.
locate_compose() {
  local found
  if [ -f "$docker_dir/compose.yaml" ] || ! command -v docker > /dev/null 2>&1; then
    return 0
  fi

  found=$(docker ps -a --filter label=com.docker.compose.project=amneziageo-server \
    --format '{{.Label "com.docker.compose.project.working_dir"}}' 2>/dev/null | head -1)
  if [ -n "$found" ] && [ -f "$found/compose.yaml" ]; then
    docker_dir=$found
  fi
}

# Tells how the panel is put on the host: package, docker, container inside the container of the panel, or none.
kind() {
  if [ -n "${AMNEZIAGEO_KIND:-}" ]; then
    printf '%s' "$AMNEZIAGEO_KIND"
  elif [ -n "${AMNEZIAGEO_CONTAINER:-}" ]; then
    printf 'container'
  elif [ -L "$base/current" ] && [ -f "/etc/systemd/system/$unit.service" ]; then
    printf 'package'
  elif [ -f "$docker_dir/compose.yaml" ] && command -v docker > /dev/null 2>&1; then
    printf 'docker'
  else
    printf 'none'
  fi
}

# Stops an item that needs the panel on a host without it.
need_panel() {
  if [ "$(kind)" = none ]; then
    bad "the panel is not on this host: item 1 installs it"
    return 1
  fi
}

# Runs docker compose in the directory of the project.
dcompose() {
  (cd "$docker_dir" && docker compose "$@")
}

# Prints the identifier of the container of the panel.
container_id() {
  dcompose ps -aq panel 2>/dev/null | head -1
}

# Prints the state of the container of the panel: running, exited, restarting or nothing.
container_state() {
  local id
  id=$(container_id)
  if [ -n "$id" ]; then
    docker inspect -f '{{.State.Status}}' "$id" 2>/dev/null
  fi
}

# Prints the identifier of the container the script runs in.
own_container() {
  grep -o '/containers/[0-9a-f]\{64\}/' /proc/self/mountinfo 2> /dev/null | head -1 | cut -d/ -f3
}

# Calls the Docker daemon through its socket and prints its answer.
engine() {
  local method=$1 path=$2 body=${3:-}
  if [ ! -S "$docker_socket" ]; then
    return 1
  fi

  if [ -n "$body" ]; then
    curl -fsS --max-time 30 --unix-socket "$docker_socket" -X "$method" -H 'Content-Type: application/json' \
      -d "$body" "http://docker$path"
  else
    curl -fsS --max-time 30 --unix-socket "$docker_socket" -X "$method" "http://docker$path"
  fi
}

# Prints what the daemon knows of the container the script runs in.
own_inspect() {
  engine GET "/containers/$(own_container)/json" 2> /dev/null
}

# Prints the name of the container the script runs in.
own_name() {
  local name
  name=$(own_inspect | grep -o '"Name":"/[^"]*"' | head -1 | cut -d/ -f2 | tr -d '"')
  printf '%s' "${name:-amneziageo-server-panel-1}"
}

# Prints a label of the container the script runs in.
own_label() {
  own_inspect | grep -o "\"$1\":\"[^\"]*\"" | head -1 | cut -d'"' -f4
}

# Prints the process of the panel the container runs, nothing while the panel is stopped.
panel_pid() {
  local pid
  pid=$(cat "$run_dir/panel.pid" 2> /dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2> /dev/null; then
    printf '%s' "$pid"
  fi
}

# Tells the loop of the container what follows the end of the panel, ends the panel and waits until it is gone.
end_panel() {
  local pid i
  touch "$run_dir/$1"
  pid=$(panel_pid)
  if [ -z "$pid" ]; then
    return 0
  fi

  kill -TERM "$pid"
  for i in $(seq 1 60); do
    if ! kill -0 "$pid" 2> /dev/null; then
      return 0
    fi

    sleep 1
  done

  bad "the panel did not stop in a minute"
  return 1
}

# Prints the log of the container the script runs in, through compose.
container_log() {
  local project service
  project=$(own_label com.docker.compose.project)
  service=$(own_label com.docker.compose.service)
  if [ -z "$project" ] || [ -z "$service" ]; then
    bad "compose did not start this container: docker logs $(own_name) on the host shows its log"
    return 1
  fi

  (cd / && docker-compose -p "$project" logs --no-log-prefix "$@" "$service")
}

# Stops an item that changes the host itself where the script runs in the container of the panel.
host_only() {
  if [ "$(kind)" = container ]; then
    bad "$1 changes the host, the container of the panel does not reach it"
    return 1
  fi
}

# Prints the command that does on the host what the container cannot reach, instead of a plain refusal.
host_command() {
  if [ "$(kind)" = container ]; then
    bad "$1 changes the host, run this on the host:"
    say "  $2"
    return 1
  fi
}

# Runs a command of the utility where the panel is put on, with no input.
cli() {
  cli_in "$@" < /dev/null
}

# Runs a command of the utility that may ask questions.
cli_in() {
  local tty=-T
  if [ -n "${AMNEZIAGEO_CLI:-}" ]; then
    $AMNEZIAGEO_CLI "$@"
    return
  fi

  case $(kind) in
    package | container)
      "$base/AmneziaGeo.Server.Cli" "$@"
      ;;
    docker)
      if [ -t 0 ] && [ -t 1 ]; then
        tty=
      fi

      if [ "$(container_state)" = running ]; then
        dcompose exec $tty panel "$base/AmneziaGeo.Server.Cli" "$@"
      else
        dcompose run --rm --no-deps $tty --entrypoint "$base/AmneziaGeo.Server.Cli" panel "$@"
      fi
      ;;
    *)
      bad "the panel is not on this host: item 1 installs it"
      return 1
      ;;
  esac
}

# Prints settings of the panel one per line, for the script to read.
setting() {
  cli panel get "$@" 2>/dev/null | tr -d '\r'
}

# Prints what the panel answers the host about itself, nothing when it does not answer.
health() {
  case $(kind) in
    package | container)
      curl -fsSk --max-time 5 "$(cat "$data/health" 2>/dev/null || echo http://127.0.0.1:8443/api/health)" 2>/dev/null
      ;;
    docker)
      if [ "$(container_state)" = running ]; then
        dcompose exec -T panel sh -c \
          'curl -fsSk --max-time 5 "$(cat /var/lib/amneziageo-server/health 2>/dev/null || echo http://127.0.0.1:8443/api/health)"' < /dev/null 2>/dev/null
      fi
      ;;
  esac
}

# Prints the version the running panel answers with.
running_version() {
  health | sed -n 's/.*"version":"\([^"]*\)".*/\1/p'
}

# Prints the scheme the panel answers the host under.
scheme() {
  local written=
  case $(kind) in
    package | container)
      written=$(cat "$data/health" 2>/dev/null)
      ;;
    docker)
      written=$(dcompose exec -T panel cat /var/lib/amneziageo-server/health < /dev/null 2>/dev/null)
      ;;
  esac

  case $written in
    https:*) printf 'https' ;;
    *) printf 'http' ;;
  esac
}

# Prints running or stopped for the panel.
panel_state() {
  case $(kind) in
    package)
      if systemctl is-active --quiet "$unit"; then
        printf 'running'
      else
        printf 'stopped'
      fi
      ;;
    docker)
      if [ "$(container_state)" = running ]; then
        printf 'running'
      else
        printf 'stopped'
      fi
      ;;
    container)
      if [ -n "$(panel_pid)" ]; then
        printf 'running'
      else
        printf 'stopped'
      fi
      ;;
    *)
      printf 'not installed'
      ;;
  esac
}

# Prints whether the panel starts with the host.
autostart_state() {
  local policy
  case $(kind) in
    package)
      if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
        printf 'on'
      else
        printf 'off'
      fi
      ;;
    docker | container)
      if [ "$(kind)" = container ]; then
        policy=$(own_inspect | sed -n 's/.*"RestartPolicy":{"Name":"\([^"]*\)".*/\1/p')
      else
        policy=$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$(container_id)" 2>/dev/null)
      fi

      if [ -n "$policy" ] && [ "$policy" != no ]; then
        printf 'on'
      else
        printf 'off'
      fi
      ;;
    *)
      printf 'off'
      ;;
  esac
}

# Tells whether the amneziawg module is loaded.
module_loaded() {
  [ -d /sys/module/amneziawg ]
}

# Tells whether the host forwards packets.
forwarding() {
  [ "$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)" = 1 ]
}

# Tells whether BBR drives TCP on the host.
bbr_on() {
  [ "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)" = bbr ]
}

# Prints the state of BBR as the host runs it.
bbr_state() {
  if bbr_on; then
    printf 'on'
  else
    printf 'off (%s)' "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)"
  fi
}

# Prints the queue discipline new interfaces take, nothing where the host keeps none of its own.
queue_of_host() {
  if [ -e "$qdisc_file" ]; then
    printf ', queue %s' "$(cat "$qdisc_file")"
  fi
}

# Lists the units of the websocket fronts, loaded or only enabled.
front_units() {
  {
    systemctl list-units --all --plain --no-legend 'amneziageo-proxy@*' 2>/dev/null | awk '{print $1}'
    find /etc/systemd/system -name 'amneziageo-proxy@?*.service' -printf '%f\n' 2>/dev/null
  } | grep -v '^$' | sort -u
}

# Counts the websocket fronts that run.
fronts_running() {
  case $(kind) in
    package)
      systemctl list-units --type=service --state=active --plain --no-legend 'amneziageo-proxy@*' 2>/dev/null | wc -l
      ;;
    container)
      grep -lx wstunnel /proc/[0-9]*/comm 2>/dev/null | wc -l
      ;;
    docker)
      if [ "$(container_state)" = running ]; then
        dcompose exec -T panel sh -c 'grep -lx wstunnel /proc/[0-9]*/comm 2>/dev/null | wc -l' < /dev/null 2>/dev/null | tr -d '\r '
      else
        printf '0'
      fi
      ;;
    *)
      printf '0'
      ;;
  esac
}

# Prints the address of the host on its default route.
public_address() {
  ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1
}

# Prints the port sshd listens on.
ssh_port() {
  local port
  port=$(sshd -T 2>/dev/null | awk '$1 == "port" {print $2; exit}')
  printf '%s' "${port:-22}"
}

# Tells whether ufw guards the host.
ufw_active() {
  if [ "$(kind)" = container ]; then
    nft list chains 2> /dev/null | grep -q 'chain ufw-user-input'
    return
  fi

  command -v ufw > /dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'
}

# Prints the address the panel opens at from outside.
address() {
  local values port path listen domains host
  mapfile -t values < <(setting port path listen domains)
  port=${values[0]:-}
  if [ -z "$port" ]; then
    return 1
  fi

  path=${values[1]:-/}
  listen=${values[2]:-}
  domains=${values[3]:-}
  if [ -n "$domains" ]; then
    host=${domains%%,*}
  elif [ -z "$listen" ]; then
    host=$(public_address)
  elif [ "$listen" = 127.0.0.1 ] || [ "$listen" = ::1 ]; then
    host=127.0.0.1
  else
    host=${listen%%,*}
  fi

  case $host in
    *:*) host="[$host]" ;;
  esac

  printf '%s://%s:%s%s' "$(scheme)" "${host:-<address of the server>}" "$port" "$path"
}

# Writes the ssh command that brings the panel to another computer and the address to open there.
ssh_command() {
  local values port path ssh host
  mapfile -t values < <(setting port path)
  port=${values[0]:-8443}
  path=${values[1]:-/}
  ssh="ssh -N -L $port:127.0.0.1:$port"
  if [ "$(ssh_port)" != 22 ]; then
    ssh="$ssh -p $(ssh_port)"
  fi

  host=$(public_address)
  say "on your computer:"
  say "  $ssh root@${host:-<address of the server>}"
  say "then open $(scheme)://localhost:$port$path"
}

# Writes where the panel opens, and the way through ssh when it keeps to the loopback.
show_address() {
  local where
  where=$(address) || return 1
  good "the panel: $where"
  case $where in
    *://127.0.0.1:*) ssh_command ;;
  esac
}

# Waits up to a minute for the panel to answer and says on which version.
wait_panel() {
  local i version
  for i in $(seq 1 30); do
    version=$(running_version)
    if [ -n "$version" ]; then
      good "the panel answers, version $version"
      return 0
    fi

    sleep 2
  done

  bad "the panel does not answer: item 19 shows its log"
  return 1
}

# Starts the panel and waits until it answers.
start_panel() {
  case $(kind) in
    package) systemctl start "$unit" ;;
    docker) dcompose up -d > /dev/null ;;
    container) rm -f "$run_dir/held" ;;
  esac

  wait_panel
}

# Stops the panel.
stop_panel() {
  case $(kind) in
    package) systemctl stop "$unit" ;;
    docker) dcompose stop panel > /dev/null ;;
    container) end_panel held ;;
  esac
}

# Starts the panel over and waits until it answers.
restart_panel() {
  case $(kind) in
    package) systemctl restart "$unit" ;;
    docker) dcompose restart panel > /dev/null ;;
    container)
      if [ -n "$(panel_pid)" ]; then
        end_panel again || return 1
      else
        rm -f "$run_dir/held"
      fi
      ;;
  esac

  wait_panel
}

# Takes the menu of the release the panel runs now.
refresh_self() {
  local next=$self.next
  case $(kind) in
    package)
      if [ -f "$base/current/amneziageo-server" ]; then
        cp "$base/current/amneziageo-server" "$next"
      fi
      ;;
    docker)
      dcompose exec -T panel cat /usr/local/share/amneziageo-server/amneziageo-server < /dev/null > "$next" 2>/dev/null
      ;;
  esac

  if [ -s "$next" ] && bash -n "$next" 2> /dev/null; then
    chmod 755 "$next"
    mv -f "$next" "$self"
  else
    rm -f "$next"
  fi
}

# Prints where the database of the panel lies on the host.
data_dir() {
  local found=
  if [ "$(kind)" = docker ]; then
    found=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/var/lib/amneziageo-server"}}{{.Source}}{{end}}{{end}}' \
      "$(container_id)" 2>/dev/null)
  fi

  printf '%s' "${found:-$data}"
}

# Prints the tag of the image the compose project runs.
image_tag() {
  sed -n 's/^AMNEZIAGEO_TAG=//p' "$docker_dir/.env" 2>/dev/null | tail -1
}

# Writes the tag of the image into the .env of the compose project and keeps its other lines.
write_tag() {
  local lines=
  if [ -f "$docker_dir/.env" ]; then
    lines=$(sed "s/^AMNEZIAGEO_TAG=.*/AMNEZIAGEO_TAG=$1/" "$docker_dir/.env")
  fi

  if ! grep -q '^AMNEZIAGEO_TAG=' <<< "$lines"; then
    lines=$lines${lines:+$'\n'}AMNEZIAGEO_TAG=$1
  fi

  printf '%s\n' "$lines" > "$docker_dir/.env"
}

# Prints the image the container of the panel runs, or the one its compose project names.
running_image() {
  local found
  if [ "$(kind)" = container ]; then
    found=$(own_inspect | sed -n 's/.*"Config":{.*"Image":"\([^"]*\)".*/\1/p')
    printf '%s' "${found:-unknown}"
    return 0
  fi

  found=$(docker inspect -f '{{.Config.Image}}' "$(container_id)" 2>/dev/null)
  if [ -z "$found" ]; then
    found=$(dcompose config --images panel 2>/dev/null | head -1)
  fi

  printf '%s' "${found:-$image:$(image_tag)}"
}

# Prints the name of the image the panel runs, without its tag and digest.
panel_repository() {
  local bare
  bare=$(running_image)
  bare=${bare%%@*}
  case ${bare##*/} in
    *:*) bare=${bare%:*} ;;
  esac

  printf '%s' "$bare"
}

# Prints the name the releases give the architecture of the host.
release_arch() {
  case $(uname -m) in
    x86_64 | amd64) printf 'x64' ;;
    aarch64 | arm64) printf 'arm64' ;;
  esac
}

# Prints the tag of the newest release of a channel that carries a signed manifest.
release_tag() {
  local tests=0
  if [ "$1" = test ]; then
    tests=1
  fi

  curl -fsSL --max-time 30 "https://api.github.com/repos/$repo/releases?per_page=30" 2>/dev/null | python3 -c '
import json, sys
tests = sys.argv[1] == "1"
for release in json.load(sys.stdin):
    if release.get("draft") or (release.get("prerelease") and not tests):
        continue
    names = {asset.get("name") for asset in release.get("assets", [])}
    if "update.json" in names and "update.json.sig" in names:
        print(release["tag_name"])
        break
' "$tests"
}

# Downloads one file of a release into a directory.
fetch() {
  if ! curl -fsSL --retry 2 -o "$3/$2" "https://github.com/$repo/releases/download/$1/$2"; then
    bad "$2 of $1 did not download"
    return 1
  fi
}

# Tells whether the manifest in a directory is signed with the key of the releases.
signed() {
  printf '%s\n' "$release_key" > "$1/release.pem"
  openssl dgst -sha256 -verify "$1/release.pem" -signature "$1/update.json.sig" "$1/update.json" > /dev/null 2>&1
}

# Prints the version a manifest names.
manifest_version() {
  sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$1" | head -1
}

# Downloads and checks the manifest of the newest release of a channel, printing its version.
manifest() {
  local channel=$1 work=$2 tag
  tag=$(release_tag "$channel")
  if [ -z "$tag" ]; then
    bad "GitHub names no release on the $channel channel"
    return 1
  fi

  fetch "$tag" update.json "$work" || return 1
  fetch "$tag" update.json.sig "$work" || return 1
  if ! signed "$work"; then
    bad "the manifest of $tag is not signed with the key of the releases"
    return 1
  fi

  printf '%s %s' "$tag" "$(manifest_version "$work/update.json")"
}

# Builds the amneziawg module from the PPA of Amnezia and loads it at boot.
install_module() {
  local suite swap= built=
  apt-get install -y --no-install-recommends dkms gcc make "linux-headers-$(uname -r)" || return 1
  apt-get install -y --no-install-recommends "linux-headers-$(uname -r | cut -d- -f3-)" > /dev/null 2>&1 || true
  install -d -m 755 /etc/apt/keyrings
  curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0x$ppa_key" \
    -o /etc/apt/keyrings/amnezia-ppa.asc || return 1
  if command -v gpg > /dev/null 2>&1 \
    && ! gpg --show-keys --with-colons /etc/apt/keyrings/amnezia-ppa.asc 2>/dev/null | grep -q ":$ppa_key:"; then
    bad "the key of the Amnezia PPA does not carry the fingerprint $ppa_key"
    return 1
  fi

  if [ "$(awk '/MemTotal/ {print $2}' /proc/meminfo)" -lt 1000000 ] && [ -z "$(swapon --show --noheadings 2>/dev/null)" ]; then
    swap=/swap-amneziageo-build
    fallocate -l 512M "$swap" && chmod 600 "$swap" && mkswap "$swap" > /dev/null && swapon "$swap"
  fi

  for suite in noble jammy; do
    printf 'Types: deb\nURIs: https://ppa.launchpadcontent.net/amnezia/ppa/ubuntu/\nSuites: %s\nComponents: main\nSigned-By: /etc/apt/keyrings/amnezia-ppa.asc\n' \
      "$suite" > /etc/apt/sources.list.d/amnezia-ppa.sources
    if apt-get update > /dev/null && apt-get install -y --no-install-recommends amneziawg-dkms; then
      built=1
      break
    fi
  done

  if [ -n "$swap" ]; then
    swapoff "$swap"
    rm -f "$swap"
  fi

  if [ -z "$built" ]; then
    bad "amneziawg-dkms did not install: /var/lib/dkms/amneziawg/*/build/make.log tells why"
    return 1
  fi

  printf 'amneziawg\n' > /etc/modules-load.d/amneziawg.conf
  modprobe amneziawg
}

# Turns forwarding on now and at boot.
forwarding_on() {
  printf 'net.ipv4.ip_forward = 1\nnet.ipv6.conf.all.forwarding = 1\n' > "$forwarding_conf"
  sysctl -p "$forwarding_conf" > /dev/null
  good "forwarding on"
}

# Turns BBR with the fq queue on now and at boot.
bbr_enable() {
  modprobe tcp_bbr 2> /dev/null || true
  if ! grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2> /dev/null; then
    bad "the kernel $(uname -r) carries no BBR"
    return 1
  fi

  printf 'tcp_bbr\n' > "$bbr_module"
  {
    if [ -e "$qdisc_file" ]; then
      printf 'net.core.default_qdisc = fq\n'
    fi

    printf 'net.ipv4.tcp_congestion_control = bbr\n'
  } > "$bbr_conf"
  sysctl -p "$bbr_conf" > /dev/null || return 1
  good "BBR on"
}

# Turns BBR off and puts the defaults of the kernel back.
bbr_disable() {
  local others
  rm -f "$bbr_conf" "$bbr_module"
  sysctl -w net.ipv4.tcp_congestion_control=cubic > /dev/null
  if [ -e "$qdisc_file" ]; then
    sysctl -w net.core.default_qdisc=fq_codel > /dev/null
  fi

  others=$(grep -ls 'tcp_congestion_control *= *bbr' /etc/sysctl.conf /etc/sysctl.d/*.conf 2> /dev/null | tr '\n' ' ')
  if [ -n "$others" ]; then
    bad "BBR comes back at boot from $others"
  fi

  good "BBR off"
}

# Puts on what the host needs for the endpoints: the amneziawg module, forwarding and, when asked, BBR.
prepare_host() {
  step "the host"
  apt-get update > /dev/null || return 1
  apt-get install -y --no-install-recommends curl ca-certificates nftables openssl python3 || return 1
  if ! module_loaded && ! modprobe amneziawg 2> /dev/null; then
    install_module || return 1
  fi

  good "amneziawg module loaded"
  if ! forwarding; then
    forwarding_on
  fi

  if ! bbr_on && agree "Turn BBR on?"; then
    bbr_enable
  fi
}

# Puts Docker on from the repository of Docker and keeps it off the forwarded packets.
install_docker() {
  local dist
  if ! command -v docker > /dev/null 2>&1 || ! docker compose version > /dev/null 2>&1; then
    # shellcheck disable=SC1091
    . /etc/os-release
    dist=debian
    if [ "${ID:-}" = ubuntu ]; then
      dist=ubuntu
    fi

    install -d -m 755 /etc/apt/keyrings
    curl -fsSL "https://download.docker.com/linux/$dist/gpg" -o /etc/apt/keyrings/docker.asc || return 1
    printf 'Types: deb\nURIs: https://download.docker.com/linux/%s\nSuites: %s\nComponents: stable\nSigned-By: /etc/apt/keyrings/docker.asc\n' \
      "$dist" "${VERSION_CODENAME:-}" > /etc/apt/sources.list.d/docker.sources
    apt-get update > /dev/null && apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin || return 1
  fi

  if [ ! -f /etc/docker/daemon.json ]; then
    printf '{\n  "ip-forward-no-drop": true\n}\n' > /etc/docker/daemon.json
    systemctl restart docker
  elif ! grep -q '"ip-forward-no-drop"' /etc/docker/daemon.json; then
    bad "add \"ip-forward-no-drop\": true to /etc/docker/daemon.json and restart docker: clients reach nothing past the host without it"
  fi
}

# Writes the compose file of the panel the instructions give.
write_compose() {
  cat > "$docker_dir/compose.yaml" <<EOF
name: amneziageo-server

services:
  panel:
    image: $image:\${AMNEZIAGEO_TAG:-latest}
    network_mode: host
    cap_add:
      - NET_ADMIN
    env_file:
      - path: server.env
        required: false
    volumes:
      - $data:/var/lib/amneziageo-server
      - $etc:/etc/amneziageo-server
      - $endpoints:/etc/amnezia/amneziawg
      - /var/run/docker.sock:/var/run/docker.sock
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    restart: unless-stopped
EOF
}

# Downloads the newest release of a channel, checks it against the key of the releases and puts it on as a package.
install_package() {
  local channel=$1 work found tag version file want rc
  step "the package"
  work=$(mktemp -d) || return 1
  found=$(manifest "$channel" "$work") || { rm -rf "$work"; return 1; }
  tag=${found%% *}
  version=${found#* }
  file=amneziageo-server-$version-linux-$(release_arch).tar.gz
  fetch "$tag" "$file" "$work" || { rm -rf "$work"; return 1; }
  want=$(grep -A3 "\"$file\"" "$work/update.json" | sed -n 's/.*"sha256": *"\([0-9a-f]*\)".*/\1/p' | head -1)
  if [ -z "$want" ] || ! (cd "$work" && printf '%s  %s\n' "$want" "$file" | sha256sum -c - > /dev/null 2>&1); then
    bad "$file does not match the manifest of $tag"
    rm -rf "$work"
    return 1
  fi

  rc=0
  tar -xzf "$work/$file" -C "$work" && "$work/amneziageo-server/install.sh" || rc=$?
  rm -rf "$work"
  return $rc
}

# Puts the panel on as a container of the image of the newest release of a channel.
install_container() {
  local channel=$1 work found version
  step "the container"
  install_docker || return 1
  work=$(mktemp -d) || return 1
  found=$(manifest "$channel" "$work") || { rm -rf "$work"; return 1; }
  rm -rf "$work"
  version=${found#* }
  mkdir -p "$docker_dir" "$data" "$etc" "$endpoints"
  printf 'AMNEZIAGEO_TAG=%s\n' "$version" > "$docker_dir/.env"
  write_compose
  dcompose pull && dcompose up -d || return 1
  good "the container of $version runs"
}

# Makes the first administrator of a fresh panel.
first_admin() {
  local login
  login=$(ask "Login of the first administrator [admin]:" admin)
  cli_in init --user "$login" --permanent
}

# Item 1: puts the panel on a clean host as a package or a container, on the database of a backup when given one.
install_panel() {
  local way channel copy=${1:-} said
  if [ "$(kind)" != none ]; then
    say "the panel is already on this host as a $(kind): item 2 updates it"
    return 0
  fi

  if ! grep -qsE '^ID(_LIKE)?=.*(debian|ubuntu)' /etc/os-release; then
    bad "the installer knows Debian and Ubuntu"
    confirm "Go on anyway?" || return 1
  fi

  if [ -z "$(release_arch)" ]; then
    bad "there are no releases for $(uname -m)"
    return 1
  fi

  say "  1. Package"
  say "  2. Docker"
  way=$(ask "Install as [1]:" 1)
  say "  1. Stable"
  say "  2. Test"
  channel=stable
  if [ "$(ask "Channel [1]:" 1)" = 2 ]; then
    channel=test
  fi

  if [ -z "$copy" ]; then
    copy=$(ask "Backup file to restore, empty for a fresh panel:")
  fi

  if [ -n "$copy" ]; then
    said=$(check_copy "$copy")
    if [ "$said" != ok ]; then
      bad "$copy: $said"
      return 1
    fi
  fi

  prepare_host || return 1
  if [ "$way" = 2 ]; then
    install_container "$channel" || return 1
  else
    install_package "$channel" || return 1
  fi

  if [ -n "$copy" ]; then
    step "the backup"
    if [ "$way" = 2 ]; then
      wait_panel
      refresh_self
    fi

    restore_copy "$copy"
    return
  fi

  step "the first administrator"
  first_admin || return 1
  if [ "$channel" = test ]; then
    cli panel set --channel test > /dev/null
  fi

  if [ "$way" = 2 ]; then
    wait_panel
    refresh_self
  else
    start_panel
  fi

  if confirm "Let the panel answer on every address of the host?"; then
    if ufw_active; then
      cli panel set --listen all --opened on > /dev/null
    else
      cli panel set --listen all > /dev/null
    fi

    restart_panel
  fi

  show_address
}

# Items 2 and 3: moves the panel to the newest release of its channel, of the test channel for a beta.
update_panel() {
  local before rc
  need_panel || return 1
  if [ "$(panel_state)" != running ]; then
    bad "the panel does not run: item 15 starts it"
    return 1
  fi

  before=$(running_version)
  if [ "${1:-}" = beta ]; then
    cli update apply --beta
  else
    cli update apply
  fi

  rc=$?
  case $rc in
    0) ;;
    3) return 0 ;;
    *) return 1 ;;
  esac

  if [ "$(kind)" = container ]; then
    say "the container moves to the new release and this session ends; the menu opens again with:"
    say "  docker exec -it $(own_name) amneziageo-server"
  fi

  wait_version "$before"
}

# Waits up to five minutes for the panel to answer on another version.
wait_version() {
  local before=$1 now i
  for i in $(seq 1 150); do
    sleep 2
    now=$(running_version)
    if [ -n "$now" ] && [ "$now" != "$before" ]; then
      printf '\n'
      good "the panel runs $now"
      refresh_self
      return 0
    fi

    printf '.'
  done

  printf '\n'
  bad "the panel did not come back on a new version"
  cli update status
  return 1
}

# Puts a copy of the database back while the panel is stopped, the database it held kept aside.
restore_backup() {
  local dir copies choice picked aside was i
  dir=$(data_dir)
  mapfile -t copies < <(ls -1t "$dir/backup" 2> /dev/null)
  if [ ${#copies[@]} -eq 0 ]; then
    say "there are no copies in $dir/backup"
    return 0
  fi

  for i in "${!copies[@]}"; do
    printf '  %d. %s\n' $((i + 1)) "${copies[$i]}"
  done

  choice=$(ask "Copy to put back:")
  if ! [[ $choice =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt ${#copies[@]} ]; then
    return 0
  fi

  picked=$dir/backup/${copies[$((choice - 1))]}
  confirm "Put $picked back?" || return 0
  was=$(panel_state)
  stop_panel
  aside=$dir/backup/$(date -u +%Y%m%d-%H%M%S)-before-restore
  mkdir -p "$aside"
  cp -a "$dir"/server.db* "$aside/" 2> /dev/null
  rm -f "$dir/server.db-wal" "$dir/server.db-shm"
  cp -a "$picked"/server.db* "$dir/"
  good "put back $picked, the database before it lies in $aside"
  if [ "$was" = running ]; then
    start_panel
  fi
}

# Copies the database aside while the panel is stopped for a moment.
take_backup() {
  local dir target was
  confirm "The panel stops for a moment. Go on?" || return 0
  dir=$(data_dir)
  target=$dir/backup/$(date -u +%Y%m%d-%H%M%S)-by-hand
  was=$(panel_state)
  stop_panel
  mkdir -p "$target"
  cp -a "$dir"/server.db* "$target/" && good "copied the database to $target"
  if [ "$was" = running ]; then
    start_panel
  fi
}

# Offers the copy of the database taken before the last update back.
offer_backup() {
  if confirm "Put back a copy of the database taken before an update too?"; then
    restore_backup
  fi
}

# Prints ok for a sound database of the panel, or what is wrong with it; a database of the host to compare it with
# turns down a backup of a newer release.
check_copy() {
  if [ "$(kind)" = container ]; then
    cli backup check "$1" | tr -d '\r'
    return 0
  fi

  if ! command -v python3 > /dev/null 2>&1; then
    printf 'python3 checks the backup: apt-get install python3'
    return 0
  fi

  python3 - "$1" "${2:-}" <<'EOF'
import os, pathlib, sqlite3, sys

def newest(db):
    try:
        return db.execute("select max(MigrationId) from __EFMigrationsHistory").fetchone()[0] or ""
    except sqlite3.DatabaseError:
        return ""

copy, held = sys.argv[1], sys.argv[2]
if not os.path.isfile(copy):
    print("there is no such file")
    sys.exit()

with open(copy, "rb") as head:
    if head.read(16) != b"SQLite format 3\x00":
        print("not a database")
        sys.exit()

try:
    db = sqlite3.connect(pathlib.Path(copy).resolve().as_uri() + "?mode=ro&immutable=1", uri=True)
    sound = db.execute("pragma integrity_check").fetchone()[0] == "ok"
    tables = {row[0] for row in db.execute("select name from sqlite_master where type = 'table'")}
    mine = newest(db)
    db.close()
except sqlite3.DatabaseError:
    print("the database is damaged")
    sys.exit()

if not {"__EFMigrationsHistory", "Panel", "Configs", "AspNetUsers"} <= tables:
    print("not a database of the panel")
elif not sound:
    print("the database is damaged")
elif held and os.path.isfile(held):
    db = sqlite3.connect(held)
    known = newest(db)
    db.close()
    print("the backup comes from a newer release of the panel, update the panel first" if known and mine > known else "ok")
else:
    print("ok")
EOF
}

# Tells whether the host carries an address the panel listens on.
carried() {
  case $1 in
    127.* | ::1 | 0.0.0.0 | ::) return 0 ;;
  esac

  ip -o addr show 2> /dev/null | awk '{sub(/\/.*/, "", $4); print $4}' | grep -qxF "$1"
}

# Fits the settings of a restored panel to this host: the certificate it lacks, the addresses it does not carry and
# the port of the panel in ufw.
fit_host() {
  local values chain listen opened port name live kept one now list fix=()
  mapfile -t values < <(setting certificate listen opened port)
  chain=${values[0]:-}
  listen=${values[1]:-}
  opened=${values[2]:-}
  port=${values[3]:-}
  if [ -n "$chain" ] && [ ! -f "$chain" ]; then
    bad "the panel answers under $chain, which this host lacks"
    name=$(basename "$(dirname "$chain")")
    name=${name%-[0-9][0-9][0-9][0-9]}
    live=/etc/letsencrypt/live/$name
    if [[ $chain == /etc/letsencrypt/live/* ]] && confirm "Get a Let's Encrypt certificate for $name now? The name has to point at this host"; then
      certify "$name"
    fi

    if [ ! -f "$chain" ] && [[ $chain == /etc/letsencrypt/live/* ]] && [ -f "$live/fullchain.pem" ]; then
      chain=$live/fullchain.pem
      fix+=(--certificate "$chain" --key "$live/privkey.pem")
    elif [ ! -f "$chain" ]; then
      chain=
      fix+=(--certificate none)
      say "the panel answers without a certificate until item 22 gets one"
    fi
  fi

  now=$listen
  if [ -n "$listen" ]; then
    kept=
    IFS=, read -ra list <<< "$listen"
    for one in "${list[@]}"; do
      if carried "$one"; then
        kept=${kept:+$kept,}$one
      else
        bad "this host carries no address $one"
      fi
    done

    if [ -z "$kept" ] && agree "Let the panel answer on every address of the host?"; then
      kept=all
    fi

    if [ "$kept" != "$listen" ]; then
      now=${kept:-127.0.0.1}
      fix+=(--listen "$now")
    fi
  fi

  if ufw_active && [ "$opened" = off ] && [ "$now" != 127.0.0.1 ] && [ "$now" != ::1 ] \
    && agree "Hold TCP port $port open in the firewall?"; then
    fix+=(--opened on)
  fi

  if [ "$(kind)" = docker ] && [[ $chain == /etc/letsencrypt/* ]]; then
    share_certificates stopped || return 1
  fi

  if [ ${#fix[@]} -gt 0 ]; then
    cli panel set "${fix[@]}" > /dev/null || return 1
  fi
}

# Puts a backup downloaded from a panel in place of the database, keeping the database it replaces aside, and starts
# the panel on it.
restore_copy() {
  local file=$1 dir said aside
  dir=$(data_dir)
  if [ ! -f "$dir/server.db" ]; then
    cli panel get port > /dev/null 2>&1
  fi

  said=$(check_copy "$file" "$dir/server.db")
  if [ "$said" != ok ]; then
    bad "$file: $said"
    return 1
  fi

  stop_panel
  aside=$dir/backup/$(date -u +%Y%m%d-%H%M%S)-before-restore
  mkdir -p "$aside"
  cp -a "$dir"/server.db* "$aside/" 2> /dev/null
  rm -f "$dir/server.db-wal" "$dir/server.db-shm"
  install -m 600 "$file" "$dir/server.db" || return 1
  good "restored $file, the database before it lies in $aside"
  fit_host || return 1
  start_panel || return 1
  cli geo update
  show_address
}

# Puts a backup downloaded from a panel on, asking for the file when not given one.
restore_file() {
  local file=${1:-}
  need_panel || return 1
  if [ -z "$file" ]; then
    file=$(ask "Backup file, like /root/amneziageo-<name>-<time>.db:")
  fi

  if [ -z "$file" ]; then
    return 0
  fi

  confirm "The panel stops while $file goes in. Go on?" || return 0
  restore_copy "$file"
}

# Item 4: goes back to the release before the current one.
rollback_panel() {
  local current previous
  need_panel || return 1
  host_only "going back to an older image" || return 1
  if [ "$(kind)" = package ]; then
    if [ ! -L "$base/previous" ]; then
      bad "there is no release to go back to"
      return 1
    fi

    confirm "Go back to $(basename "$(readlink "$base/previous")")?" || return 0
    "$base/current/install.sh" --rollback || return 1
    offer_backup
    return 0
  fi

  current=$(image_tag)
  previous=$(docker images "$(panel_repository)" --format '{{.Tag}}' 2> /dev/null | grep -E '^[0-9]+(\.[0-9]+)+$' \
    | { cat; printf '%s\n' "$current"; } | sort -uV | grep -B1 -x "$current" | head -1)
  if [ -z "$previous" ] || [ "$previous" = "$current" ]; then
    bad "the host keeps no image older than $current"
    return 1
  fi

  confirm "Go back from $current to $previous?" || return 0
  write_tag "$previous"
  dcompose up -d > /dev/null && wait_panel
  offer_backup
}

# Lists the releases the host keeps.
list_releases() {
  case $(kind) in
    package)
      "$base/current/install.sh" --list
      ;;
    container)
      say "the container runs $(running_image)"
      engine GET /images/json 2> /dev/null | grep -o "\"$(panel_repository):[^\"]*\"" | tr -d '"' | sort -uV
      ;;
    *)
      say "the project runs $(running_image)"
      docker images "$(panel_repository)"
      ;;
  esac
}

# Lists the copies of the database.
list_backups() {
  local dir
  dir=$(data_dir)/backup
  if ! ls -1t "$dir" 2> /dev/null | grep -q .; then
    say "there are no copies in $dir"
    return 0
  fi

  say "$dir:"
  du -sh "$dir"/* 2> /dev/null | sort -k2 -r
}

# Sets the channel the panel takes its releases from.
channel_item() {
  local choice
  say "the panel takes releases from the $(setting channel) channel"
  say "  1. Stable"
  say "  2. Test"
  choice=$(ask "Channel:")
  case $choice in
    1) cli panel set --channel stable ;;
    2) cli panel set --channel test ;;
  esac
}

# Puts on the web interface of an unpacked package while the server runs on.
web_package() {
  local dir
  if [ "$(kind)" != package ]; then
    bad "a web interface alone goes on a package, a container takes whole images"
    return 1
  fi

  dir=$(ask "Directory of the unpacked package:")
  if [ ! -x "$dir/install.sh" ]; then
    bad "$dir holds no install.sh"
    return 1
  fi

  "$dir/install.sh" --ui
}

# Item 5: the releases on the host, the copies of the database and the channel.
releases_menu() {
  local choice
  need_panel || return 1
  while true; do
    step "Releases & Backups"
    say "  1. Releases on this host"
    say "  2. Database backups"
    say "  3. Put a database backup back"
    say "  4. Restore a backup file"
    say "  5. Back up the database now"
    say "  6. Release channel"
    say "  7. Look for a new release"
    say "  8. Put on a web interface package"
    say "  0. Back"
    choice=$(ask "Choose:") || return 0
    case $choice in
      1) list_releases ;;
      2) list_backups ;;
      3) restore_backup ;;
      4) restore_file ;;
      5) take_backup ;;
      6) channel_item ;;
      7) cli update check ;;
      8) web_package ;;
      0 | "") return 0 ;;
      *) bad "there is no item $choice" ;;
    esac
  done
}

# Takes the interfaces, the firewall rules and the tables the panel raised off the host.
clear_host() {
  local name family table number
  for name in "$@"; do
    if ip -d link show "$name" 2> /dev/null | grep -q amneziawg; then
      ip link delete "$name" && say "removed the interface $name"
    fi
  done

  nft list tables 2> /dev/null | awk '$3 ~ /^amneziageo/ {print $2, $3}' | while read -r family table; do
    nft delete table "$family" "$table" && say "removed the table $family $table"
  done

  if command -v ufw > /dev/null 2>&1; then
    while number=$(ufw status numbered 2> /dev/null | grep -m1 'amneziageo' | sed -n 's/^\[ *\([0-9]*\)\].*/\1/p') \
      && [ -n "$number" ]; do
      ufw --force delete "$number" > /dev/null || break
    done
  fi
}

# Item 6: takes the panel off the host, its database and settings too when asked.
uninstall_panel() {
  local kind names name repository keep=yes
  need_panel || return 1
  host_only "taking the panel off" || return 1
  kind=$(kind)
  confirm "Remove the panel from this host?" || return 0
  if confirm "Remove its database and settings too?"; then
    keep=no
  fi

  names=$(cli endpoint list 2> /dev/null | tr -d '\r' | sed -n 's/^\([^:]*\): port .*/\1/p')
  step "the panel"
  if [ "$kind" = package ]; then
    systemctl disable --now "$unit" 2> /dev/null
    for name in $(front_units); do
      systemctl disable --now "$name" 2> /dev/null
    done

    rm -f "/etc/systemd/system/$unit.service" /etc/systemd/system/amneziageo-proxy@.service
    systemctl daemon-reload
    rm -rf "$base" /usr/local/bin/wstunnel
    rm -f "$etc"/proxy-*.env
  else
    repository=$(panel_repository)
    if [ "$keep" = no ]; then
      dcompose down -v
    else
      dcompose down
    fi

    if confirm "Remove the images of the panel too?"; then
      { docker images -q "$repository"; docker images -q "$image"; } | sort -u | xargs -r docker rmi -f > /dev/null
    fi
  fi

  step "what the panel raised on the host"
  # shellcheck disable=SC2086
  clear_host $names
  if [ "$keep" = no ]; then
    for name in $names; do
      rm -f "$endpoints/$name.conf"
    done

    rm -rf "$data" "$etc"
    if [ "$kind" = docker ]; then
      rm -rf "$docker_dir"
    fi

    good "removed the database and the settings"
  else
    say "the database stays in $(data_dir), the settings in $etc"
  fi

  say "left on the host: the amneziawg module, $forwarding_conf"
  rm -f "$self"
  good "the panel is off the host"
  exit 0
}

# Item 7: sets the password of an administrator, or makes one under a new login.
reset_login() {
  local login users
  need_panel || return 1
  users=$(cli user list 2> /dev/null | tr -d '\r')
  printf '%s\n' "$users"
  login=$(ask "Login:")
  if [ -z "$login" ]; then
    return 0
  fi

  if printf '%s\n' "$users" | awk 'NR > 1 {print $1}' | grep -qx "$login"; then
    cli_in user passwd "$login" --permanent && cli user enable "$login" > /dev/null
  elif ! agree "There is no $login. Make an administrator $login?"; then
    return 0
  elif printf '%s\n' "$users" | grep -q '^no users yet'; then
    cli_in init --user "$login" --permanent
  else
    cli_in user add "$login" --role admin --permanent
  fi
}

# Item 8: the users of the panel and their roles.
users_menu() {
  local choice
  need_panel || return 1
  while true; do
    step "Users & Roles"
    say "  1. Users"
    say "  2. Add a user"
    say "  3. Password of a user"
    say "  4. Role of a user"
    say "  5. Enable a user"
    say "  6. Disable a user"
    say "  7. Remove a user"
    say "  8. Roles"
    say "  9. Add a role"
