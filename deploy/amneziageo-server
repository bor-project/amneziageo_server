# Writes how the script is called.
usage() {
  cat <<'EOF'
usage:
  amneziageo-server                    open the menu
  amneziageo-server install [--restore <file>] [--answers <file>]
                                       look the host over, ask what the panel needs and put it on,
                                       on a backup downloaded from a panel, with answers of a file
  amneziageo-server restore <file>     put a backup downloaded from a panel in place of the database
  amneziageo-server update [beta]      move the panel to the newest release, of the test channel for beta
  amneziageo-server rollback           go back to the release before
  amneziageo-server uninstall          take the panel off this host
  amneziageo-server settings           what the panel answers under
  amneziageo-server start | stop | restart | status
  amneziageo-server log                follow the log of the panel
  amneziageo-server enable | disable   start the panel with the host or not
  amneziageo-server bbr [on | off]     BBR with the fq queue for TCP
  amneziageo-server dns [on | off]     the resolver of the clients, which asks outside over HTTPS
  amneziageo-server dns open           let the clients of the endpoints reach the resolver through ufw
  amneziageo-server <command>          a command of the utility: user, role, token, panel, endpoint,
                                       import, device, family, geo, dns, init, login, whoami, update status
EOF
}

# Runs the menu, an item or a command of the utility.
main() {
  case ${1:-} in
    help | -h | --help)
      usage
      return 0
      ;;
  esac

  need_root
  locate_compose
  case ${1:-} in
    "")
      follow_release
      menu
      ;;
    install)
      shift
      while [ $# -gt 0 ]; do
        case $1 in
          --restore)
            given[restore]=${2:-}
            ;;
          --answers)
            if [ ! -f "${2:-}" ]; then
              bad "there is no file of answers ${2:-}"
              return 1
            fi

            load_answers "$2"
            ;;
          *)
            usage
            return 1
            ;;
        esac

        shift 2 || { usage; return 1; }
      done

      install_panel
      ;;
    restore) restore_file "${2:-}" ;;
    update)
      case ${2:-} in
        "") update_panel ;;
        beta) update_panel beta ;;
        *) cli_in "$@" ;;
      esac
      ;;
    rollback) rollback_panel ;;
    uninstall) uninstall_panel ;;
    settings) view_settings ;;
    start) need_panel && start_panel ;;
    stop) need_panel && stop_panel ;;
    restart) need_panel && restart_panel ;;
    status) check_status ;;
    log) need_panel && follow_log ;;
    enable) autostart on ;;
    disable) autostart off ;;
    bbr) bbr_item "${2:-}" ;;
    dns)
      case ${2:-} in
        "" | on | off) resolver_item "${2:-}" ;;
        open) need_panel && resolver_open ;;
        *) cli_in "$@" ;;
      esac
      ;;
    *) cli_in "$@" ;;
  esac
}

main "$@"
