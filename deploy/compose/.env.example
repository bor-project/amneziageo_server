COMPOSE_PROJECT_NAME=amneziageo-server
AMNEZIAGEO_IMAGE=ghcr.io/bor-project/amneziageo-server
# Select a published numeric image version that includes the bootstrap command.
AMNEZIAGEO_TAG=
AMNEZIAGEO_RUNTIME_ENV=./server.env
AMNEZIAGEO_BOOTSTRAP_FILE=./bootstrap.json
AMNEZIAGEO_PASSWORD_FILE=./secrets/admin_password
AMNEZIAGEO_DATA_DIR=./data
AMNEZIAGEO_SETTINGS_DIR=./settings
AMNEZIAGEO_ENDPOINTS_DIR=./endpoints
AMNEZIAGEO_CERTIFICATES_DIR=./certificates
AMNEZIAGEO_DOCKER_SOCKET=/var/run/docker.sock
AMNEZIAGEO_RESTART=unless-stopped
AMNEZIAGEO_LOG_SIZE=10m
AMNEZIAGEO_LOG_FILES=3
TZ=Etc/UTC
