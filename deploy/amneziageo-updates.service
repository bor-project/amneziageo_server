[Unit]
Description=AmneziaGeo Client Updates Server
Documentation=https://github.com/bor-project/amneziageo_server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/opt/amneziageo-updates/current
ExecStart=/opt/amneziageo-updates/current/AmneziaGeo.Server.Updates.Host
Environment=DOTNET_NOLOGO=1
Environment=Updates__Directory=/var/lib/amneziageo-updates
Environment=Updates__Etc=/etc/amneziageo-updates
EnvironmentFile=-/etc/amneziageo-updates/updates.env
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/amneziageo-updates /etc/amneziageo-updates
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
