[Unit]
Description=AmneziaGeo Server
Documentation=https://github.com/bor-project/amneziageo_server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/amneziageo-server
ExecStart=/opt/amneziageo-server/AmneziaGeo.Server.Api
Environment=DOTNET_NOLOGO=1
Environment=Web__Listen__0=127.0.0.1:8443
Environment=Endpoints__Directory=/etc/amnezia/amneziawg
Environment=Geo__Path=/var/lib/amneziageo-server/geo
EnvironmentFile=-/etc/amneziageo-server/server.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
